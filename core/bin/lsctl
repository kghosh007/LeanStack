    print(f'Domain:          https://{r[\"domain\"]}')
    print(f'Tenant User:     {r[\"user\"]}')
    print(f'PHP Version:     {r[\"php_version\"]} ({r[\"pool_mode\"]}, {r[\"memory_limit\"]})')
    print(f'Profile Used:    {r[\"profile_used\"]}')
