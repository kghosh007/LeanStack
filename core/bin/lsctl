            elif ':' in s:
                k, v = s.split(':', 1)
                k = k.strip()
                v = v.strip().strip('"').strip("'")
                curr_key = k
                if v == 'true': v = True
                elif v == 'false': v = False
                elif not v: v = []
                profiles[current][k] = v
    return profiles

p_file = sys.argv[1]
p_name = sys.argv[2]
json_mode = int(sys.argv[3])
try:
    if not os.path.exists(p_file):
        print(f"ERROR: Profiles file {p_file} not found.", file=sys.stderr)
