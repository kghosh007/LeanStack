PY
        exit 0
        ;;

    site:list)
        init_db
        JSON_MODE=0
        for arg in "$@"; do
            [ "$arg" == "--json" ] && JSON_MODE=1
        done

        if [ "$JSON_MODE" -eq 1 ]; then
            python3 -c "
import sqlite3, json
conn = sqlite3.connect('$DB_FILE')
conn.row_factory = sqlite3.Row
cur = conn.cursor()
