#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET="${SCRIPT_DIR}/ls-cron-queue"
if [ ! -x "$TARGET" ] && [ -x "/usr/local/bin/ls-cron-queue" ]; then
    TARGET="/usr/local/bin/ls-cron-queue"
fi

TARGET_REAL="$(readlink -f "$TARGET" 2>/dev/null || echo "$TARGET")"
CUR_REAL="$(readlink -f "$0" 2>/dev/null || echo "$0")"

if [ -n "${_LEANSTACK_CPCRON_LOOP:-}" ] || [ "$TARGET_REAL" == "$CUR_REAL" ]; then
    echo "❌ Error: Circular delegation detected. cp-cron-queue and ls-cron-queue resolve to the same binary ($CUR_REAL)." >&2
    exit 1
fi

export _LEANSTACK_CPCRON_LOOP=1
exec "$TARGET" "$@"
