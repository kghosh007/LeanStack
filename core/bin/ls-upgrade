#!/usr/bin/env python3
"""
LeanStack Autonomous Upgrade & Migration Engine (cp-upgrade)
Provides zero-downtime, safe, and automated upgrades across multi-server fleets:
- Pre-flight health and syntax checks
- Git repository synchronization (pulls latest release / main branch)
- Incremental SQLite schema migrations without data loss (via core/migrations/)
- Control plane binary & template synchronization (/usr/local/bin, /etc/cpctl)
- Atomic synchronization of MU-plugins across all tenant sites
- Per-tenant Nginx & FastCGI cache zone configuration reconciliation
- Automated rollback on syntax check failure
- Version tracking in /etc/leanstack/version.json
"""

import sys
import os
import re
import shutil
import sqlite3
import subprocess
import time
import argparse
import json
import importlib.util
from typing import Dict, Any, List, Tuple


class Colors:
    GREEN = "\033[32m"
    CYAN = "\033[36m"
    YELLOW = "\033[33m"
    RED = "\033[31m"
    BOLD = "\033[1m"
    DIM = "\033[2m"
    RESET = "\033[0m"


class LeanStackUpgrader:

    def __init__(self, repo_dir: str = None, db_file: str = None, dry_run: bool = False, force: bool = False, quiet: bool = False):
        self.dry_run = dry_run
        self.force = force
        self.quiet = quiet

        # Auto-detect repository / base directory
        if repo_dir:
            self.base_dir = os.path.abspath(repo_dir)
        elif os.path.exists("/opt/leanstack"):
            self.base_dir = "/opt/leanstack"
        else:
            self.base_dir = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))

        # Paths
        self.core_dir = os.path.join(self.base_dir, "core")
        self.migrations_dir = os.path.join(self.core_dir, "migrations")
        self.bin_dir = os.path.join(self.core_dir, "bin")
        self.templates_dir = os.path.join(self.core_dir, "templates")
        self.profiles_src = os.path.join(self.core_dir, "config", "profiles.yaml")
        self.systemd_dir = os.path.join(self.base_dir, "systemd")

        if db_file:
            self.db_file = db_file
        elif os.environ.get("LEANSTACK_DB"):
            self.db_file = os.environ.get("LEANSTACK_DB")
        elif os.path.exists("/var/lib/lsctl/sites.db"):
            self.db_file = "/var/lib/lsctl/sites.db"
        elif os.path.exists("/var/lib/cpctl/sites.db"):
            self.db_file = "/var/lib/cpctl/sites.db"
        else:
            self.db_file = "/var/lib/lsctl/sites.db"

        self.backup_dir = "/var/backups/lsctl"
        self.version_file = "/etc/leanstack/version.json"

    def log(self, msg: str, color: str = Colors.RESET, prefix: str = ">>>"):
        if self.quiet:
            return
        print(f"{color}{prefix} {msg}{Colors.RESET}")

    def preflight_check(self) -> bool:
        """Verifies system syntax and environment readiness before modifying state."""
        self.log("Running pre-flight system integrity checks...", Colors.CYAN)

        # 1. Check Angie syntax if installed
        if shutil.which("angie"):
            res = subprocess.run(["angie", "-t"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            if res.returncode != 0:
                self.log("Pre-flight failure: Angie web server configuration currently contains errors!", Colors.RED, prefix="❌")
                self.log(res.stderr.strip(), Colors.DIM)
                return False
            self.log("Angie configuration syntax verified: OK", Colors.GREEN, prefix="  ✔")

        # 2. Check Database path
        if not os.path.exists(self.db_file):
            if not self.dry_run:
                db_dir = os.path.dirname(self.db_file)
                os.makedirs(db_dir, exist_ok=True)
            self.log(f"Database will be initialized at {self.db_file}", Colors.DIM, prefix="  ℹ")

        return True

    def backup_database(self) -> str:
        """Creates an atomic snapshot backup of the sites database prior to migrations."""
        if not os.path.exists(self.db_file):
            return ""

        ts = time.strftime("%Y%m%d_%H%M%S")
        backup_path = os.path.join(self.backup_dir, f"sites_pre_upgrade_{ts}.db")

        if not self.dry_run:
            os.makedirs(self.backup_dir, exist_ok=True)
            shutil.copy2(self.db_file, backup_path)
            self.log(f"Database snapshot backed up to: {backup_path}", Colors.GREEN, prefix="  ✔")
        else:
            self.log(f"[Dry-Run] Would back up {self.db_file} to {backup_path}", Colors.YELLOW, prefix="  [DRY-RUN]")

        return backup_path

    def git_pull_latest(self) -> bool:
        """Checks for git updates and pulls fast-forward from origin if in a git repository."""
        git_dir = os.path.join(self.base_dir, ".git")
        if not os.path.isdir(git_dir):
            self.log(f"Directory {self.base_dir} is not a git clone; skipping git pull.", Colors.DIM, prefix="  ℹ")
            return True

        self.log(f"Checking for updates from remote repository at {self.base_dir}...", Colors.CYAN)
        try:
            # Check for unstaged changes
            res_status = subprocess.run(["git", "status", "--porcelain"], cwd=self.base_dir, stdout=subprocess.PIPE, text=True, check=True)
            if res_status.stdout.strip() and not self.force:
                self.log("Local modified files detected in LeanStack install directory. Skipping git pull to preserve local edits.", Colors.YELLOW, prefix="  ⚠️")
                return True

            # Fetch origin
            subprocess.run(["git", "fetch", "--tags", "origin"], cwd=self.base_dir, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True)

            # Check rev-list
            res_rev = subprocess.run(["git", "rev-list", "HEAD..@{u}", "--count"], cwd=self.base_dir, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            behind_count = int(res_rev.stdout.strip()) if res_rev.returncode == 0 and res_rev.stdout.strip().isdigit() else 0

            if behind_count == 0:
                self.log("Repository is up to date with remote.", Colors.GREEN, prefix="  ✔")
                return True

            self.log(f"Found {behind_count} new commits on remote. Pulling latest release...", Colors.CYAN, prefix="  ⬇")
            if not self.dry_run:
                res_pull = subprocess.run(["git", "pull", "--ff-only"], cwd=self.base_dir, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=True)
                self.log("Git pull completed successfully.", Colors.GREEN, prefix="  ✔")
            else:
                self.log(f"[Dry-Run] Would execute: git pull --ff-only in {self.base_dir}", Colors.YELLOW, prefix="  [DRY-RUN]")

            return True
        except subprocess.CalledProcessError as e:
            self.log(f"Git operation failed: {e}", Colors.YELLOW, prefix="  ⚠️")
            return False

    def run_migrations(self) -> int:
        """Executes pending forward SQLite migrations non-destructively."""
        self.log("Checking database schema migrations...", Colors.CYAN)
        db_target = self.db_file
        if not os.path.exists(self.db_file):
            if self.dry_run:
                db_target = ":memory:"
            else:
                os.makedirs(os.path.dirname(self.db_file), exist_ok=True)
        else:
            if not self.dry_run:
                os.makedirs(os.path.dirname(self.db_file), exist_ok=True)

        conn = sqlite3.connect(db_target)
        cur = conn.cursor()

        # Ensure migration tracking table exists
        cur.execute("""
            CREATE TABLE IF NOT EXISTS schema_migrations (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                version INTEGER UNIQUE NOT NULL,
                name TEXT NOT NULL,
                applied_at DATETIME DEFAULT CURRENT_TIMESTAMP
            );
        """)
        conn.commit()

        # Fetch already applied migrations
        cur.execute("SELECT version FROM schema_migrations;")
        applied = set(row[0] for row in cur.fetchall())

        if not os.path.exists(self.migrations_dir):
            conn.close()
            return 0

        # Discover migration files
        files = os.listdir(self.migrations_dir)
        pending: List[Tuple[int, str, str]] = []

        for f in files:
            if f.endswith(".sql") or f.endswith(".py"):
                parts = f.split("_", 1)
                if parts[0].isdigit():
                    v = int(parts[0])
                    pending.append((v, f, os.path.join(self.migrations_dir, f)))

        pending.sort(key=lambda x: x[0])
        applied_count = 0

        for ver, fname, full_path in pending:
            if ver in applied and not self.force:
                continue

            self.log(f"Applying migration [{ver:04d}]: {fname}...", Colors.CYAN, prefix="  ⚡")

            if self.dry_run:
                self.log(f"[Dry-Run] Would execute migration {fname}", Colors.YELLOW, prefix="  [DRY-RUN]")
                applied_count += 1
                continue

            try:
                if fname.endswith(".sql"):
                    with open(full_path, "r", encoding="utf-8") as f_sql:
                        statements = f_sql.read()
                    cur.executescript(statements)
                elif fname.endswith(".py"):
                    spec = importlib.util.spec_from_file_location(f"mig_{ver}", full_path)
                    mod = importlib.util.module_from_spec(spec)
                    spec.loader.exec_module(mod)
                    if hasattr(mod, "migrate"):
                        mod.migrate(conn)

                cur.execute("INSERT OR REPLACE INTO schema_migrations (version, name) VALUES (?, ?);", (ver, fname))
                conn.commit()
                applied_count += 1
                self.log(f"Migration [{ver:04d}] {fname} applied successfully.", Colors.GREEN, prefix="  ✔")
            except Exception as e:
                conn.rollback()
                conn.close()
                self.log(f"Migration {fname} failed: {e}", Colors.RED, prefix="❌")
                raise

        conn.close()
        if applied_count == 0:
            self.log("Database schema is fully up to date.", Colors.GREEN, prefix="  ✔")
        return applied_count

    def sync_binaries(self):
        """Installs/updates control plane executables into /usr/local/bin."""
        self.log("Synchronizing control plane binaries to /usr/local/bin...", Colors.CYAN)
        if not os.path.exists(self.bin_dir):
            return

        target_dir = "/usr/local/bin"
        if not self.dry_run and not os.path.exists(target_dir):
            os.makedirs(target_dir, exist_ok=True)

        for b in os.listdir(self.bin_dir):
            src = os.path.join(self.bin_dir, b)
            dest = os.path.join(target_dir, b)
            if os.path.isfile(src) and not b.startswith("."):
                if not self.dry_run:
                    shutil.copy2(src, dest)
                    os.chmod(dest, 0o755)
                    self.log(f"Installed {dest}", Colors.DIM, prefix="  ✔")
                else:
                    self.log(f"[Dry-Run] Would copy {src} -> {dest}", Colors.YELLOW, prefix="  [DRY-RUN]")

        # Create backwards-compatible legacy symlinks in /usr/local/bin
        legacy_links = [
            ("cpctl", "lsctl"),
            ("cp-upgrade", "ls-upgrade"),
            ("cp-gatekeeper", "ls-gatekeeper"),
            ("cp-nginx-linter", "ls-nginx-linter"),
            ("cp-cron-queue", "ls-cron-queue"),
            ("cp-cf-sync", "ls-cf-sync"),
            ("cp-watcher", "ls-watcher"),
            ("cp-autoupdate", "ls-autoupdate")
        ]
        for leg_name, target_name in legacy_links:
            leg_path = os.path.join(target_dir, leg_name)
            if not self.dry_run:
                try:
                    if os.path.islink(leg_path) or os.path.exists(leg_path):
                        os.remove(leg_path)
                    os.symlink(target_name, leg_path)
                except Exception:
                    pass

    def sync_templates_and_profiles(self):
        """Updates templates in /etc/lsctl/templates and merges profiles.yaml."""
        self.log("Synchronizing templates & operational profiles...", Colors.CYAN)
        target_tpl = "/etc/lsctl/templates"
        if not self.dry_run:
            os.makedirs(target_tpl, exist_ok=True)
            # Legacy directory link
            if not os.path.exists("/etc/cpctl"):
                try:
                    os.symlink("/etc/lsctl", "/etc/cpctl")
                except Exception:
                    pass

        if os.path.exists(self.templates_dir):
            for t in os.listdir(self.templates_dir):
                src = os.path.join(self.templates_dir, t)
                dest = os.path.join(target_tpl, t)
                if os.path.isfile(src):
                    if not self.dry_run:
                        shutil.copy2(src, dest)
                    else:
                        self.log(f"[Dry-Run] Would update template: {dest}", Colors.YELLOW, prefix="  [DRY-RUN]")

        # Ensure profiles.yaml exists without wiping custom profiles
        target_prof = "/etc/lsctl/profiles.yaml"
        if not os.path.exists(target_prof) and os.path.exists(self.profiles_src):
            if not self.dry_run:
                shutil.copy2(self.profiles_src, target_prof)
                self.log(f"Installed baseline profiles to {target_prof}", Colors.GREEN, prefix="  ✔")

        # Systemd service unit files and drop-in overrides
        if os.path.exists(self.systemd_dir) and os.path.isdir("/etc/systemd/system"):
            for s in os.listdir(self.systemd_dir):
                if s.endswith(".service") or s.endswith(".timer"):
                    src = os.path.join(self.systemd_dir, s)
                    dest = f"/etc/systemd/system/{s}"
                    if not self.dry_run:
                        shutil.copy2(src, dest)

            overrides_dir = os.path.join(self.systemd_dir, "overrides")
            if os.path.isdir(overrides_dir):
                for dropin in os.listdir(overrides_dir):
                    s_dropin = os.path.join(overrides_dir, dropin)
                    if os.path.isdir(s_dropin):
                        d_dropin = f"/etc/systemd/system/{dropin}"
                        if not self.dry_run:
                            os.makedirs(d_dropin, exist_ok=True)
                            for f in os.listdir(s_dropin):
                                shutil.copy2(os.path.join(s_dropin, f), os.path.join(d_dropin, f))

            if not self.dry_run and shutil.which("systemctl"):
                subprocess.run(["systemctl", "daemon-reload"], check=False)
                subprocess.run(["systemctl", "enable", "--now", "cp-cron.timer", "ls-watcher.timer", "ls-autoupdate.timer"], check=False)

        # Ensure default fallback SSL certificate exists for Angie
        ssl_dir = "/etc/angie/ssl"
        if os.path.isdir("/etc/angie") and not (os.path.exists(f"{ssl_dir}/default.crt") and os.path.exists(f"{ssl_dir}/default.key")):
            if not self.dry_run:
                os.makedirs(ssl_dir, exist_ok=True)
                subprocess.run([
                    "openssl", "req", "-x509", "-nodes", "-days", "3650", "-newkey", "rsa:2048",
                    "-keyout", f"{ssl_dir}/default.key",
                    "-out", f"{ssl_dir}/default.crt",
                    "-subj", "/CN=leanstack-fallback/O=LeanStack/C=US"
                ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
                if os.path.exists(f"{ssl_dir}/default.key"):
                    try: os.chmod(f"{ssl_dir}/default.key", 0o600)
                    except Exception: pass
                if os.path.exists(f"{ssl_dir}/default.crt"):
                    try: os.chmod(f"{ssl_dir}/default.crt", 0o644)
                    except Exception: pass
                self.log(f"Generated fallback SSL certificates in {ssl_dir}", Colors.GREEN, prefix="  ✔")

        # Synchronize Angie Snippets (/etc/angie/snippets)
        snippets_dir = os.path.join(self.core_dir, "snippets")
        target_snip = "/etc/angie/snippets"
        if os.path.exists(snippets_dir) and os.path.isdir("/etc/angie"):
            if not self.dry_run:
                os.makedirs(target_snip, exist_ok=True)
                for s in os.listdir(snippets_dir):
                    if s.endswith(".conf"):
                        shutil.copy2(os.path.join(snippets_dir, s), os.path.join(target_snip, s))
                self.log(f"Synchronized Angie snippets in {target_snip}", Colors.GREEN, prefix="  ✔")
            else:
                self.log(f"[Dry-Run] Would synchronize snippets to {target_snip}", Colors.YELLOW, prefix="  [DRY-RUN]")

        # Ensure Angie cache-purge dynamic module loader is scaffolded if shared library exists
        purge_mod_paths = [
            "/usr/lib/angie/modules/ngx_http_cache_purge_module.so",
            "/etc/angie/modules/ngx_http_cache_purge_module.so"
        ]
        has_purge_so = any(os.path.exists(p) for p in purge_mod_paths)
        purge_conf = "/etc/angie/modules.d/cache-purge.conf"
        angie_conf = "/etc/angie/angie.conf"
        if has_purge_so and os.path.isdir("/etc/angie"):
            if not os.path.exists(purge_conf):
                if not self.dry_run:
                    os.makedirs("/etc/angie/modules.d", exist_ok=True)
                    with open(purge_conf, "w") as f:
                        f.write("load_module modules/ngx_http_cache_purge_module.so;\n")
                    self.log("Scaffolded cache-purge module loader in /etc/angie/modules.d/cache-purge.conf", Colors.GREEN, prefix="  ✔")
                    if shutil.which("systemctl"):
                        subprocess.run(["systemctl", "restart", "angie"], check=False)
                else:
                    self.log("[Dry-Run] Would scaffold /etc/angie/modules.d/cache-purge.conf", Colors.YELLOW, prefix="  [DRY-RUN]")

            # Ensure angie.conf includes modules.d
            if os.path.exists(angie_conf):
                with open(angie_conf, "r") as f:
                    a_content = f.read()
                if "modules.d" not in a_content:
                    if not self.dry_run:
                        with open(angie_conf, "w") as f:
                            f.write("include /etc/angie/modules.d/*.conf;\n" + a_content)
                        if shutil.which("systemctl"):
                            subprocess.run(["systemctl", "restart", "angie"], check=False)
                    else:
                        self.log("[Dry-Run] Would add modules.d include to /etc/angie/angie.conf", Colors.YELLOW, prefix="  [DRY-RUN]")
        elif not has_purge_so and os.path.exists(purge_conf):
            if not self.dry_run:
                try:
                    os.remove(purge_conf)
                except Exception:
                    pass

    def sync_tenants(self) -> int:
        """
        Synchronizes all existing active tenant sites:
        - Deploys updated MU-plugins (leanstack-bridge, leanstack-holepunch, leanstack-apcu, leanstack-shield)
        - Ensures tenant Nginx custom files and cache-config.conf exist
        - Ensures dedicated per-site FastCGI cache directories and Angie cache zones exist
        """
        self.log("Reconciling and upgrading active tenant sites...", Colors.CYAN)
        if not os.path.exists(self.db_file):
            return 0

        conn = sqlite3.connect(self.db_file)
        conn.row_factory = sqlite3.Row
        cur = conn.cursor()

        try:
            cur.execute("SELECT domain, user, site_path, php_version FROM sites;")
            sites = cur.fetchall()
        except sqlite3.OperationalError:
            conn.close()
            return 0

        synced_count = 0
        php_reloaded_needed = False
        mu_plugins = [
            ("leanstack-bridge.php.tpl", "leanstack-bridge.php"),
            ("leanstack-holepunch.php.tpl", "leanstack-holepunch.php"),
            ("leanstack-apcu.php.tpl", "leanstack-apcu.php"),
            ("leanstack-shield.php.tpl", "leanstack-shield.php"),
        ]

        for s in sites:
            domain = s["domain"]
            user = s["user"]
            site_path = s["site_path"]

            self.log(f"Synchronizing tenant: {domain} (user: {user})...", Colors.DIM, prefix="  🔄")

            if not self.dry_run:
                # 1. Update MU-Plugins
                mu_dir = os.path.join(site_path, "wp-content", "mu-plugins")
                if os.path.isdir(mu_dir):
                    for tpl_name, plugin_name in mu_plugins:
                        tpl_path = os.path.join(self.templates_dir, tpl_name)
                        if os.path.exists(tpl_path):
                            dest = os.path.join(mu_dir, plugin_name)
                            shutil.copy2(tpl_path, dest)
                            try:
                                import pwd
                                u_info = pwd.getpwnam(user)
                                os.chown(dest, u_info.pw_uid, u_info.pw_gid)
                                os.chmod(dest, 0o644)
                            except Exception:
                                pass

                # 2. Reconcile Tenant Nginx Custom Files
                tenant_nginx = f"/home/{user}/nginx"
                prod_custom = f"/etc/angie/tenant-custom/{domain}"
                if os.path.isdir(f"/home/{user}"):
                    os.makedirs(tenant_nginx, exist_ok=True)
                    os.makedirs(prod_custom, exist_ok=True)

                    # Ensure cache-config.conf exists
                    cache_cfg = os.path.join(tenant_nginx, "cache-config.conf")
                    if not os.path.exists(cache_cfg):
                        with open(cache_cfg, "w") as f:
                            f.write("# Tenant FastCGI Cache Configuration\nset $site_cache_enabled 1;\nset $site_cache_ttl 3600s;\n")
                        shutil.copy2(cache_cfg, os.path.join(prod_custom, "cache-config.conf"))

                    # Ensure security-headers.conf exists
                    sec_hdr = os.path.join(tenant_nginx, "security-headers.conf")
                    prod_sec_hdr = os.path.join(prod_custom, "security-headers.conf")
                    if not os.path.exists(sec_hdr):
                        with open(sec_hdr, "w") as f:
                            f.write("""# Tenant Security Headers & Policies
add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "SAMEORIGIN" always;
add_header X-XSS-Protection "1; mode=block" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
add_header Content-Security-Policy "default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval'; worker-src 'self' blob:; frame-ancestors 'self';" always;
add_header Alt-Svc 'h3=":443"; ma=86400';
""")
                        shutil.copy2(sec_hdr, prod_sec_hdr)
                    elif not os.path.exists(prod_sec_hdr):
                        shutil.copy2(sec_hdr, prod_sec_hdr)

                # 3. Ensure Dedicated Cache Directory & Angie Zone Exist
                site_cache_dir = f"/var/cache/angie/sites/{domain}"
                if os.path.isdir("/var/cache/angie"):
                    os.makedirs(site_cache_dir, exist_ok=True)
                    try:
                        import pwd, grp
                        u_info = pwd.getpwnam(user)
                        w_info = grp.getgrnam("www-data")
                        os.chown(site_cache_dir, u_info.pw_uid, w_info.gr_gid)
                        os.chmod(site_cache_dir, 0o770)
                    except Exception:
                        pass

                zone_key = "".join(c if c.isalnum() else "_" for c in domain.lower())
                zone_conf = f"/etc/angie/cache-zones/{domain}.conf"
                if os.path.isdir("/etc/angie/cache-zones") and not os.path.exists(zone_conf):
                    with open(zone_conf, "w") as f:
                        f.write(f"fastcgi_cache_path {site_cache_dir} levels=1:2 keys_zone=CACHE_{zone_key}:20m inactive=7d max_size=512m use_temp_path=off;\n")

                # 3b. Reconcile PHP-FPM Pool open_basedir Permissions
                php_ver = s["php_version"] if "php_version" in s.keys() else "8.5"
                pool_paths = [
                    f"/etc/php/{php_ver}/fpm/pool.d/{user}.conf",
                    f"/etc/php/8.5/fpm/pool.d/{user}.conf",
                    f"/etc/php/8.4/fpm/pool.d/{user}.conf",
                    f"/etc/php/8.3/fpm/pool.d/{user}.conf",
                    f"/etc/php/8.2/fpm/pool.d/{user}.conf",
                    f"/etc/php/8.1/fpm/pool.d/{user}.conf",
                ]
                for pp in pool_paths:
                    if os.path.isfile(pp):
                        try:
                            with open(pp, "r") as f_pf:
                                p_content = f_pf.read()
                            if "/run/valkey" not in p_content or "/run/mysqld" not in p_content:
                                def _update_ob(m):
                                    line = m.group(0)
                                    if "/run/valkey" not in line:
                                        line += ":/run/valkey"
                                    if "/run/mysqld" not in line:
                                        line += ":/run/mysqld"
                                    return line
                                p_new = re.sub(r"php_admin_value\[open_basedir\]\s*=\s*[^\n]+", _update_ob, p_content)
                                if p_new != p_content:
                                    with open(pp, "w") as f_pf:
                                        f_pf.write(p_new)
                                    php_reloaded_needed = True
                                    self.log(f"Updated PHP-FPM open_basedir with Valkey/MariaDB sockets for {user} ({pp})", Colors.GREEN, prefix="  ✔")
                        except Exception as e:
                            self.log(f"Notice: Pool update for {user}: {e}", Colors.DIM, prefix="  ℹ")

                # 4. Reconcile Valkey Cache Credentials in wp-config.php
                wp_config = os.path.join(site_path, "wp-config.php")
                if not os.path.isfile(wp_config):
                    alt_wpc = os.path.join(os.path.dirname(site_path), "wp-config.php")
                    if os.path.isfile(alt_wpc):
                        wp_config = alt_wpc

                valkey_pass = None
                valkey_db = "1"
                if os.path.isfile(wp_config):
                    try:
                        with open(wp_config, "r") as f_wpc:
                            wpc = f_wpc.read()

                        m_pass = re.search(r"define\s*\(\s*['\"]WP_REDIS_PASSWORD['\"]\s*,\s*['\"]([^'\"]+)['\"]", wpc)
                        if m_pass:
                            valkey_pass = m_pass.group(1)
                        m_db = re.search(r"define\s*\(\s*['\"]WP_REDIS_DATABASE['\"]\s*,\s*([0-9]+)", wpc)
                        if m_db:
                            valkey_db = m_db.group(1)

                        modified = False
                        # 4a. Backfill / Harmonize WP_REDIS_USERNAME and WP_REDIS_USER
                        if re.search(r"define\s*\(\s*['\"]WP_REDIS_USERNAME['\"]\s*,\s*['\"][^'\"]*['\"]\s*\)", wpc):
                            wpc_new = re.sub(
                                r"define\s*\(\s*['\"]WP_REDIS_USERNAME['\"]\s*,\s*['\"][^'\"]*['\"]\s*\)",
                                f"define( 'WP_REDIS_USERNAME', '{user}' )",
                                wpc
                            )
                            if wpc_new != wpc:
                                wpc = wpc_new
                                modified = True
                        if re.search(r"define\s*\(\s*['\"]WP_REDIS_USER['\"]\s*,\s*['\"][^'\"]*['\"]\s*\)", wpc):
                            wpc_new = re.sub(
                                r"define\s*\(\s*['\"]WP_REDIS_USER['\"]\s*,\s*['\"][^'\"]*['\"]\s*\)",
                                f"define( 'WP_REDIS_USER', '{user}' )",
                                wpc
                            )
                            if wpc_new != wpc:
                                wpc = wpc_new
                                modified = True

                        if "WP_REDIS_USERNAME" not in wpc or "WP_REDIS_USER" not in wpc:
                            if "WP_REDIS_USERNAME" not in wpc and "WP_REDIS_USER" in wpc:
                                wpc = re.sub(
                                    r"(define\s*\(\s*['\"]WP_REDIS_USER['\"])",
                                    f"define( 'WP_REDIS_USERNAME', '{user}' );\n\\1",
                                    wpc,
                                    count=1
                                )
                                modified = True
                            elif "WP_REDIS_USER" not in wpc and "WP_REDIS_USERNAME" in wpc:
                                wpc = re.sub(
                                    r"(define\s*\(\s*['\"]WP_REDIS_USERNAME['\"])",
                                    f"\\1\ndefine( 'WP_REDIS_USER', '{user}' );",
                                    wpc,
                                    count=1
                                )
                                modified = True
                            elif re.search(r"define\s*\(\s*['\"]WP_REDIS_PASSWORD['\"]", wpc):
                                wpc = re.sub(
                                    r"(define\s*\(\s*['\"]WP_REDIS_PASSWORD['\"])",
                                    f"define( 'WP_REDIS_USERNAME', '{user}' );\ndefine( 'WP_REDIS_USER', '{user}' );\n\\1",
                                    wpc,
                                    count=1
                                )
                                modified = True
                            elif "WP_REDIS_PATH" in wpc:
                                wpc = re.sub(
                                    r"(define\s*\(\s*['\"]WP_REDIS_PATH['\"][^\n]*\n)",
                                    f"\\1define( 'WP_REDIS_USERNAME', '{user}' );\ndefine( 'WP_REDIS_USER', '{user}' );\n",
                                    wpc,
                                    count=1
                                )
                                modified = True

                        # 4b. Ensure WP_CACHE is enabled
                        if re.search(r"//\s*define\s*\(\s*['\"]WP_CACHE['\"]", wpc):
                            wpc = re.sub(r"//\s*define\s*\(\s*['\"]WP_CACHE['\"][^\n]*\n", "define( 'WP_CACHE', true );\n", wpc, count=1)
                            modified = True
                        elif re.search(r"/\*+[\s*]*define\s*\(\s*['\"]WP_CACHE['\"].*?\*/", wpc, re.DOTALL):
                            wpc = re.sub(r"/\*+[\s*]*define\s*\(\s*['\"]WP_CACHE['\"].*?\*/", "define( 'WP_CACHE', true );", wpc, count=1)
                            modified = True
                        elif re.search(r"define\s*\(\s*['\"]WP_CACHE['\"]\s*,\s*(?:false|0)\s*\)", wpc, re.IGNORECASE):
                            wpc = re.sub(r"define\s*\(\s*['\"]WP_CACHE['\"]\s*,\s*(?:false|0)\s*\)", "define( 'WP_CACHE', true )", wpc, count=1, flags=re.IGNORECASE)
                            modified = True
                        elif "WP_CACHE" not in wpc:
                            if "WP_REDIS_SCHEME" in wpc:
                                wpc = re.sub(
                                    r"(define\s*\(\s*['\"]WP_REDIS_SCHEME['\"])",
                                    "define( 'WP_CACHE', true );\n\\1",
                                    wpc,
                                    count=1
                                )
                                modified = True
                            elif "WP_REDIS_PATH" in wpc:
                                wpc = re.sub(
                                    r"(define\s*\(\s*['\"]WP_REDIS_PATH['\"])",
                                    "define( 'WP_CACHE', true );\n\\1",
                                    wpc,
                                    count=1
                                )
                                modified = True
                            elif "<?php" in wpc:
                                wpc = re.sub(r"<\?php\s*", "<?php\ndefine( 'WP_CACHE', true );\n", wpc, count=1)
                                modified = True

                        if modified:
                            with open(wp_config, "w") as f_wpc:
                                f_wpc.write(wpc)
                            import pwd, grp
                            try:
                                u_info = pwd.getpwnam(user)
                                w_info = grp.getgrnam("www-data")
                                os.chown(wp_config, u_info.pw_uid, w_info.gr_gid)
                                os.chmod(wp_config, 0o640)
                            except Exception:
                                pass
                            self.log(f"Injected WP_REDIS_USERNAME & WP_CACHE into {domain} wp-config.php", Colors.GREEN, prefix="  ✔")
                    except Exception as e:
                        self.log(f"Warning: Reconciling wp-config.php for {domain}: {e}", Colors.YELLOW, prefix="  ⚠️")

                # 5. Reconcile Valkey ACL User & Permissions
                acl_file = "/etc/valkey/users.acl"
                if os.path.isfile(acl_file) or os.path.isdir("/etc/valkey"):
                    try:
                        acl_content = ""
                        if os.path.exists(acl_file):
                            with open(acl_file, "r") as f_acl:
                                acl_content = f_acl.read()

                        acl_changed = False
                        if not re.search(r"^user\s+default\s+.*nopass", acl_content, re.MULTILINE):
                            if re.search(r"^user\s+default\s+.*$", acl_content, re.MULTILINE):
                                acl_content = re.sub(r"^user\s+default\s+.*$", "user default on nopass ~* &* +@all", acl_content, flags=re.MULTILINE)
                            else:
                                acl_content = "user default on nopass ~* &* +@all\n" + acl_content
                            acl_changed = True

                        if valkey_pass:
                            user_rule = f"user {user} on >{valkey_pass} ~* +@all -@admin -@dangerous -flushall -shutdown -config -debug -monitor +select +flushdb\n"
                            user_pattern = rf"^user\s+{re.escape(user)}\s+.*$"
                            if re.search(user_pattern, acl_content, re.MULTILINE):
                                acl_content_new = re.sub(user_pattern, user_rule.strip(), acl_content, flags=re.MULTILINE)
                                if acl_content_new != acl_content:
                                    acl_content = acl_content_new
                                    acl_changed = True
                            else:
                                if acl_content and not acl_content.endswith("\n"):
                                    acl_content += "\n"
                                acl_content += user_rule
                                acl_changed = True
                        elif f"user {user} " in acl_content and f"~{user}:*" in acl_content:
                            acl_content = acl_content.replace(f"~{user}:*", "~*")
                            acl_changed = True

                        if acl_changed:
                            with open(acl_file, "w") as f_acl:
                                f_acl.write(acl_content)
                            import pwd, grp
                            try:
                                v_u = pwd.getpwnam("valkey")
                                v_g = grp.getgrnam("valkey")
                                os.chown(acl_file, v_u.pw_uid, v_g.gr_gid)
                                os.chmod(acl_file, 0o640)
                            except Exception:
                                pass
                            cli_cmd = shutil.which("valkey-cli") or shutil.which("redis-cli") or ("/usr/local/bin/valkey-cli" if os.path.exists("/usr/local/bin/valkey-cli") else ("/usr/bin/valkey-cli" if os.path.exists("/usr/bin/valkey-cli") else None))
                            if cli_cmd:
                                subprocess.run([cli_cmd, "-s", "/run/valkey/valkey.sock", "acl", "load"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
                            self.log(f"Harmonized Valkey ACL permissions (~*) for {user}", Colors.GREEN, prefix="  ✔")
                    except Exception as e:
                        self.log(f"Warning: Valkey ACL update for {user}: {e}", Colors.YELLOW, prefix="  ⚠️")

                # 6. Ensure Redis Object Cache Drop-in is enabled if redis-cache plugin exists
                rc_plugin = os.path.join(site_path, "wp-content", "plugins", "redis-cache")
                rc_dropin = os.path.join(site_path, "wp-content", "object-cache.php")
                if os.path.isdir(rc_plugin):
                    needs_copy = False
                    if not os.path.exists(rc_dropin) or os.path.getsize(rc_dropin) == 0:
                        needs_copy = True
                    else:
                        try:
                            with open(rc_dropin, "r", errors="ignore") as f_drop:
                                if "Redis Object Cache" not in f_drop.read(500):
                                    needs_copy = True
                        except Exception:
                            needs_copy = True

                    if needs_copy:
                        try:
                            plugin_dropin = os.path.join(rc_plugin, "includes", "object-cache.php")
                            if not os.path.isfile(plugin_dropin):
                                plugin_dropin = os.path.join(rc_plugin, "object-cache.php")
                            if os.path.isfile(plugin_dropin):
                                shutil.copy2(plugin_dropin, rc_dropin)
                                import pwd, grp
                                try:
                                    u_info = pwd.getpwnam(user)
                                    w_info = grp.getgrnam("www-data")
                                    os.chown(rc_dropin, u_info.pw_uid, w_info.gr_gid)
                                    os.chmod(rc_dropin, 0o644)
                                    self.log(f"Installed object-cache.php drop-in for {domain}", Colors.GREEN, prefix="  ✔")
                                except Exception:
                                    pass
                        except Exception as e:
                            self.log(f"Warning: Object-cache drop-in install for {domain}: {e}", Colors.YELLOW, prefix="  ⚠️")

                    try:
                        wp_bin = shutil.which("wp") or ("/usr/local/bin/wp" if os.path.exists("/usr/local/bin/wp") else ("/usr/bin/wp" if os.path.exists("/usr/bin/wp") else None))
                        php_ver_str = s["php_version"] if "php_version" in s.keys() else "8.5"
                        php_bin = f"/usr/bin/php{php_ver_str}" if os.path.exists(f"/usr/bin/php{php_ver_str}") else (shutil.which("php") or "php")
                        if wp_bin:
                            cmd = ["sudo", "-u", user, php_bin, wp_bin, "redis", "enable", "--force", f"--path={site_path}"]
                            if hasattr(os, "geteuid") and os.geteuid() != 0:
                                cmd = [php_bin, wp_bin, "redis", "enable", "--force", f"--path={site_path}"]
                            subprocess.run(
                                cmd,
                                stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL,
                                check=False
                            )
                    except Exception as e:
                        pass

            synced_count += 1

        conn.close()
        self.log(f"Reconciled {synced_count} registered tenant sites.", Colors.GREEN, prefix="  ✔")

        if not self.dry_run and hasattr(os, "geteuid") and os.geteuid() == 0:
            try:
                self.sync_binaries()
                self.sync_templates_and_profiles()
            except Exception:
                pass

        if not self.dry_run and shutil.which("systemctl") and os.path.isdir("/run/systemd/system"):
            if php_reloaded_needed:
                for v_str in ["8.5", "8.4", "8.3", "8.2", "8.1"]:
                    svc = f"php{v_str}-fpm"
                    if subprocess.run(["systemctl", "is-active", "--quiet", svc], check=False).returncode == 0:
                        subprocess.run(["systemctl", "reload", svc], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
                self.log("PHP-FPM reloaded with updated socket permissions.", Colors.GREEN, prefix="  ✔")
            subprocess.run(["systemctl", "daemon-reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
            subprocess.run(["systemctl", "enable", "--now", "cp-cron.timer", "ls-watcher.timer", "ls-autoupdate.timer"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
            self.log("Background Cron Queue, Autonomous Watcher & Auto-Update Timers active.", Colors.GREEN, prefix="  ✔")

        return synced_count

    def reload_services(self) -> bool:
        """Validates configuration syntax and reloads services gracefully."""
        self.log("Validating syntax and reloading services...", Colors.CYAN)

        if shutil.which("angie"):
            res = subprocess.run(["angie", "-t"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            if res.returncode != 0:
                self.log("Angie configuration test failed after upgrade!", Colors.RED, prefix="❌")
                self.log(res.stderr.strip(), Colors.DIM)
                return False
            if not self.dry_run:
                subprocess.run(["systemctl", "reload", "angie"], check=False)
                self.log("Angie reloaded with zero downtime.", Colors.GREEN, prefix="  ✔")

        if not self.dry_run and shutil.which("systemctl"):
            subprocess.run(["systemctl", "restart", "cp-gatekeeper.service"], check=False)
            self.log("Syntax Gatekeeper restarted.", Colors.GREEN, prefix="  ✔")
            subprocess.run(["systemctl", "enable", "--now", "cp-cron.timer", "ls-watcher.timer", "ls-autoupdate.timer"], check=False)
            self.log("Background Cron Queue, Autonomous Watcher & Auto-Update Timers active.", Colors.GREEN, prefix="  ✔")

        return True

    def record_version(self, applied_count: int):
        """Records version information and timestamp into /etc/leanstack/version.json."""
        if not self.dry_run:
            os.makedirs(os.path.dirname(self.version_file), exist_ok=True)
        git_commit = "HEAD"
        try:
            res = subprocess.run(["git", "rev-parse", "HEAD"], cwd=self.base_dir, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            if res.returncode == 0 and res.stdout.strip():
                git_commit = res.stdout.strip()
        except Exception:
            pass

        data = {
            "version": "1.1.0",
            "git_commit": git_commit,
            "updated_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "last_migrations_applied": applied_count
        }

        if not self.dry_run:
            with open(self.version_file, "w") as f:
                json.dump(data, f, indent=2)

    def run_upgrade(self) -> bool:
        """Master orchestrator for the complete autonomous upgrade process."""
        print(f"\n{Colors.BOLD}{Colors.CYAN}=============================================================================={Colors.RESET}")
        print(f"{Colors.BOLD}{Colors.CYAN}            LEANSTACK AUTONOMOUS UPGRADE & MIGRATION ENGINE                   {Colors.RESET}")
        print(f"{Colors.BOLD}{Colors.CYAN}=============================================================================={Colors.RESET}\n")

        # 1. Preflight checks
        if not self.preflight_check():
            return False

        # 2. Database backup
        self.backup_database()

        # 3. Git pull
        pulled = self.git_pull_latest()
        if pulled and not self.dry_run and "--post-pull" not in sys.argv:
            new_script = os.path.join(self.core_dir, "bin", "ls-upgrade")
            if os.path.isfile(new_script):
                self.sync_binaries()
                self.sync_templates_and_profiles()
                self.log("Re-executing upgrade with updated code...", Colors.CYAN, prefix="  🔄")
                try:
                    os.execv(sys.executable, [sys.executable, new_script, "--post-pull"] + [a for a in sys.argv[1:] if a != "--post-pull"])
                except Exception:
                    pass

        # 4. Migrations
        applied = self.run_migrations()

        # 5. Binaries
        self.sync_binaries()

        # 6. Templates
        self.sync_templates_and_profiles()

        # 7. Tenant reconciliation
        self.sync_tenants()

        # 8. Reload
        if not self.reload_services():
            return False

        # 9. Record version
        self.record_version(applied)

        print(f"\n{Colors.BOLD}{Colors.GREEN}=============================================================================={Colors.RESET}")
        print(f"{Colors.BOLD}{Colors.GREEN}✔ LEANSTACK UPGRADE COMPLETED SUCCESSFULLY WITH ZERO DOWNTIME.{Colors.RESET}")
        print(f"{Colors.BOLD}{Colors.GREEN}=============================================================================={Colors.RESET}\n")
        return True


def main():
    if "--delegated" not in sys.argv and os.path.exists("/opt/leanstack/core/bin/ls-upgrade"):
        opt_real = os.path.realpath("/opt/leanstack/core/bin/ls-upgrade")
        cur_real = os.path.realpath(__file__)
        if opt_real != cur_real and os.path.isfile(opt_real):
            try:
                os.execv(sys.executable, [sys.executable, opt_real, "--delegated"] + sys.argv[1:])
            except Exception:
                pass

    parser = argparse.ArgumentParser(description="LeanStack Autonomous Upgrade & Migration Engine")
    parser.add_argument("--dry-run", action="store_true", help="Simulate upgrade steps without altering system files")
    parser.add_argument("--force", action="store_true", help="Re-apply all migrations and sync routines")
    parser.add_argument("--post-pull", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--delegated", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--repo-dir", help="Path to LeanStack repository directory")
    parser.add_argument("--db-file", help="Path to SQLite sites.db file")
    parser.add_argument("--migrate-only", action="store_true", help="Execute database schema migrations only")
    parser.add_argument("--sync-tenants-only", action="store_true", help="Reconcile tenant MU-plugins & configs only")
    parser.add_argument("--json", action="store_true", help="Output summary as JSON")

    args = parser.parse_args()

    upgrader = LeanStackUpgrader(
        repo_dir=args.repo_dir,
        db_file=args.db_file,
        dry_run=args.dry_run,
        force=args.force,
        quiet=args.json
    )

    if args.migrate_only:
        applied = upgrader.run_migrations()
        if args.json:
            print(json.dumps({"status": "ok", "migrations_applied": applied}))
        sys.exit(0)

    if args.sync_tenants_only:
        count = upgrader.sync_tenants()
        if args.json:
            print(json.dumps({"status": "ok", "tenants_synced": count}))
        sys.exit(0)

    success = upgrader.run_upgrade()
    sys.exit(0 if success else 1)


if __name__ == "__main__":
    main()
