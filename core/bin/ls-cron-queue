#!/usr/bin/env bash
# ==============================================================================
# LeanStack Centralized Anti-Thundering Cron Queue (cp-cron-queue)
# Executes WordPress scheduled tasks via WP-CLI with strict concurrency bounds
# ==============================================================================
set -euo pipefail

if [ -n "${LEANSTACK_DB:-}" ]; then
    DB_FILE="$LEANSTACK_DB"
elif [ -f "/var/lib/lsctl/sites.db" ]; then
    DB_FILE="/var/lib/lsctl/sites.db"
elif [ -f "/var/lib/cpctl/sites.db" ]; then
    DB_FILE="/var/lib/cpctl/sites.db"
else
    DB_FILE="/var/lib/lsctl/sites.db"
fi
[ ! -f "$DB_FILE" ] && exit 0

LOG_DIR="/var/log/lsctl"
if [ ! -d "$LOG_DIR" ] && [ -d "/var/log/cpctl" ]; then
    LOG_DIR="/var/log/cpctl"
fi
mkdir -p "$LOG_DIR" 2>/dev/null || LOG_DIR="/tmp"
LOG_FILE="${LOG_DIR}/cron.log"

# Atomic Flocking Mutex (guarantees zero overlapping cron batches)
LOCK_FILE="/run/ls-cron.lock"
if ! touch "$LOCK_FILE" 2>/dev/null; then
    LOCK_FILE="/tmp/ls-cron.lock"
    touch "$LOCK_FILE" 2>/dev/null || true
fi
chmod 666 "$LOCK_FILE" 2>/dev/null || true
exec 201>"$LOCK_FILE"
if ! flock -n 201; then
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Another LeanStack cron queue process is currently running. Skipping." >> "$LOG_FILE" 2>/dev/null || true
    exit 0
fi

run_site_cron() {
    local domain="$1"
    local user="$2"
    local site_path="$3"
    local php_ver="$4"

    # Dynamically resolve PHP CLI binary
    local php_bin=""
    if [ -n "$php_ver" ] && [ -x "/usr/bin/php${php_ver}" ]; then
        php_bin="/usr/bin/php${php_ver}"
    elif command -v php &>/dev/null; then
        php_bin="$(command -v php)"
    fi

    # Dynamically resolve WP-CLI binary
    local wp_bin=""
    if [ -x "/usr/local/bin/wp" ]; then
        wp_bin="/usr/local/bin/wp"
    elif [ -x "/usr/bin/wp" ]; then
        wp_bin="/usr/bin/wp"
    elif command -v wp &>/dev/null; then
        wp_bin="$(command -v wp)"
    fi

    if [ -d "$site_path" ] && [ -n "$php_bin" ] && [ -n "$wp_bin" ]; then
        # Open basedir must permit WP-CLI execution, temporary directories, socket paths, SSL certs, and tenant roots
        local allowed_paths="/home/${user}"
        if [[ "$site_path" != "/home/${user}"* ]]; then
            allowed_paths="${allowed_paths}:${site_path}"
        fi
        allowed_paths="${allowed_paths}:/usr/local/bin:/usr/bin:/usr/share/php:/tmp:/var/cache/angie/sites:/run/valkey:/run/mysqld:/proc:/etc/ssl/certs:/usr/share/ca-certificates:/etc/pki:/etc/resolv.conf"

        # WP-CLI relies on proc_open / proc_close for process management.
        # Restrict dangerous functions while allowing proc_open for WP-CLI execution.
        local disabled_funcs="exec,passthru,shell_exec,system,dl,show_source"

        local status_dir="/home/${user}/nginx"
        local alt_status_dir="${site_path}/wp-content/nginx-custom"
        local cron_meta_file="${status_dir}/.cron_status.json"
        local alt_cron_meta_file="${alt_status_dir}/.cron_status.json"

        write_cron_status() {
            local state="$1"
            local payload="{\"last_run\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\", \"status\": \"$state\"}"
            if [ -d "$status_dir" ]; then
                echo "$payload" > "$cron_meta_file" 2>/dev/null || true
                chown "${user}:www-data" "$cron_meta_file" 2>/dev/null || true
                chmod 664 "$cron_meta_file" 2>/dev/null || true
            fi
            if [ -d "$alt_status_dir" ]; then
                echo "$payload" > "$alt_cron_meta_file" 2>/dev/null || true
                chown "${user}:www-data" "$alt_cron_meta_file" 2>/dev/null || true
                chmod 664 "$alt_cron_meta_file" 2>/dev/null || true
            fi
        }

        update_cron_telemetry() {
            local dur="$1"
            local cpu="$2"
            local mem="$3"
            local cnt="$4"
            local iso="$5"

            local py_script="
import json, os, sys
meta_file, dur, cpu, mem, cnt, iso = sys.argv[1], float(sys.argv[2]), float(sys.argv[3]), float(sys.argv[4]), int(sys.argv[5]), sys.argv[6]
data = {}
if os.path.exists(meta_file):
    try:
        with open(meta_file, 'r') as f:
            data = json.load(f)
    except Exception:
        data = {}

hist = data.get('history', [])
if not isinstance(hist, list):
    hist = []
hist.insert(0, {
    'timestamp': iso,
    'duration_ms': dur,
    'cpu_ms': cpu,
    'memory_mb': mem,
    'events_processed': cnt,
    'ran_via': 'ls-cron-queue'
})
hist = hist[:20]

avg_dur = round(sum(h.get('duration_ms', 0) for h in hist) / len(hist), 2)
avg_cpu = round(sum(h.get('cpu_ms', 0) for h in hist) / len(hist), 2)
avg_mem = round(sum(h.get('memory_mb', 0) for h in hist) / len(hist), 2)
total_runs = int(data.get('total_runs', 0)) + 1
total_events = int(data.get('total_events_processed', 0)) + cnt

data.update({
    'last_run': iso,
    'status': 'completed',
    'ran_via': 'ls-cron-queue',
    'duration_ms': dur,
    'cpu_ms': cpu,
    'memory_mb': mem,
    'events_processed': cnt,
    'history': hist,
    'avg_duration_ms': avg_dur,
    'avg_cpu_ms': avg_cpu,
    'avg_memory_mb': avg_mem,
    'total_runs': total_runs,
    'total_events_processed': total_events
})

os.makedirs(os.path.dirname(meta_file), exist_ok=True)
with open(meta_file, 'w') as f:
    json.dump(data, f, indent=2)
"
            if [ -d "$status_dir" ]; then
                python3 -c "$py_script" "$cron_meta_file" "$dur" "$cpu" "$mem" "$cnt" "$iso" 2>/dev/null || true
                chown "${user}:www-data" "$cron_meta_file" 2>/dev/null || true
                chmod 664 "$cron_meta_file" 2>/dev/null || true
            fi
            if [ -d "$alt_status_dir" ]; then
                python3 -c "$py_script" "$alt_cron_meta_file" "$dur" "$cpu" "$mem" "$cnt" "$iso" 2>/dev/null || true
                chown "${user}:www-data" "$alt_cron_meta_file" 2>/dev/null || true
                chmod 664 "$alt_cron_meta_file" 2>/dev/null || true
            fi
        }

        write_cron_status "running"

        # Run WP-CLI cron as tenant user within site root with timeout and strict PHP runtime sandboxing
        local eval_php='
@ini_set("display_errors", "0");
$t0 = microtime(true);
$r0 = function_exists("getrusage") ? getrusage() : null;
$cron_array = _get_cron_array();
$executed = 0;
$now = time();
if (!empty($cron_array)) {
    foreach ($cron_array as $timestamp => $hooks) {
        if ($timestamp <= $now) {
            foreach ($hooks as $hook => $keys) {
                foreach ($keys as $k => $data) {
                    $schedule = isset($data["schedule"]) ? $data["schedule"] : false;
                    $args = isset($data["args"]) ? $data["args"] : array();
                    if ($schedule) {
                        wp_reschedule_event($timestamp, $schedule, $hook, $args);
                    }
                    wp_unschedule_event($timestamp, $hook, $args);
                    do_action_ref_array($hook, $args);
                    $executed++;
                }
            }
        }
    }
}
$dur = round((microtime(true) - $t0) * 1000, 2);
$cpu = 0;
if ($r0 && function_exists("getrusage")) {
    $r1 = getrusage();
    $utime = ($r1["ru_utime.tv_sec"] - $r0["ru_utime.tv_sec"]) + ($r1["ru_utime.tv_usec"] - $r0["ru_utime.tv_usec"]) / 1e6;
    $stime = ($r1["ru_stime.tv_sec"] - $r0["ru_stime.tv_sec"]) + ($r1["ru_stime.tv_usec"] - $r0["ru_stime.tv_usec"]) / 1e6;
    $cpu = round(($utime + $stime) * 1000, 2);
}
$mem = round(memory_get_peak_usage(true) / 1048576, 2);
echo "LS_TELEMETRY:{$dur}:{$cpu}:{$mem}:{$executed}";
'
        local cron_out=""
        cron_out=$(
            cd "$site_path" 2>/dev/null || true
            local sudo_cmd=()
            if [ "$(id -u)" -eq 0 ]; then
                sudo_cmd=(sudo -u "$user" -H)
            fi
            local err_tmp
            err_tmp=$(mktemp)

            out=$(timeout 60 "${sudo_cmd[@]}" "$php_bin" \
                -d open_basedir="${allowed_paths}" \
                -d disable_functions="${disabled_funcs}" \
                -d display_errors=Off \
                -d error_reporting="E_ALL & ~E_WARNING & ~E_NOTICE & ~E_DEPRECATED" \
                "$wp_bin" eval "$eval_php" --path="$site_path" 2> "$err_tmp" || true)

            if [[ "$out" != *"LS_TELEMETRY:"* ]]; then
                timeout 60 "${sudo_cmd[@]}" "$php_bin" \
                    -d open_basedir="${allowed_paths}" \
                    -d disable_functions="${disabled_funcs}" \
                    -d display_errors=Off \
                    -d error_reporting="E_ALL & ~E_WARNING & ~E_NOTICE & ~E_DEPRECATED" \
                    "$wp_bin" cron event run --due-now --path="$site_path" --quiet 2>> "$err_tmp" || true
            fi

            if [ -s "$err_tmp" ]; then
                grep -v -E "open_basedir restriction in effect\. File\(/home|open_basedir restriction in effect\. File\(/" "$err_tmp" >> "$LOG_FILE" || true
            fi
            rm -f "$err_tmp"

            echo "$out"
        )

        local tel_dur=0
        local tel_cpu=0
        local tel_mem=0
        local tel_count=0
        if [[ "$cron_out" =~ LS_TELEMETRY:([0-9.]+):([0-9.]+):([0-9.]+):([0-9]+) ]]; then
            tel_dur="${BASH_REMATCH[1]}"
            tel_cpu="${BASH_REMATCH[2]}"
            tel_mem="${BASH_REMATCH[3]}"
            tel_count="${BASH_REMATCH[4]}"
        fi
        local iso_now
        iso_now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        update_cron_telemetry "$tel_dur" "$tel_cpu" "$tel_mem" "$tel_count" "$iso_now"
    fi
}
export -f run_site_cron
export LOG_FILE

TARGET_DOMAIN=""
for arg in "$@"; do
    case "$arg" in
        --domain=*)
            TARGET_DOMAIN="${arg#*=}"
            ;;
        --all)
            TARGET_DOMAIN=""
            ;;
    esac
done

# Query active sites: domain, user, site_path, php_version
SITES=$(python3 -c "
import sqlite3, sys
domain_filter = '$TARGET_DOMAIN'
try:
    conn = sqlite3.connect('$DB_FILE')
    cur = conn.cursor()
    if domain_filter:
        cur.execute('SELECT domain, user, site_path, php_version FROM sites WHERE domain = ?', (domain_filter,))
    else:
        cur.execute('SELECT domain, user, site_path, php_version FROM sites')
    for row in cur.fetchall():
        print(f'{row[0]}|{row[1]}|{row[2]}|{row[3]}')
except Exception:
    pass
")

[ -z "$SITES" ] && exit 0

# Execute with max 4 parallel workers (Zero CPU starvation)
echo "$SITES" | while IFS='|' read -r domain user site_path php_ver; do
    [ -n "$domain" ] && echo "$domain $user $site_path $php_ver"
done | xargs -r -n 4 -P 4 bash -c 'run_site_cron "$@"' _
