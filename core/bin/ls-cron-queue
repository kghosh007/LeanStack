#!/usr/bin/env bash
# ==============================================================================
# LeanStack Centralized Anti-Thundering Cron Queue (cp-cron-queue)
# Executes WordPress scheduled tasks via WP-CLI with strict concurrency bounds
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -d "${SCRIPT_DIR}/../lib" ]; then
    LIB_DIR="$(cd "${SCRIPT_DIR}/../lib" && pwd)"
elif [ -d "/opt/leanstack/core/lib" ]; then
    LIB_DIR="/opt/leanstack/core/lib"
elif [ -d "/etc/lsctl/lib" ]; then
    LIB_DIR="/etc/lsctl/lib"
else
    LIB_DIR="${SCRIPT_DIR}/../lib"
fi

if [ -n "${LEANSTACK_DB:-}" ]; then
    DB_FILE="$LEANSTACK_DB"
elif [ -f "/var/lib/lsctl/sites.db" ]; then
    DB_FILE="/var/lib/lsctl/sites.db"
elif [ -f "/var/lib/cpctl/sites.db" ]; then
    DB_FILE="/var/lib/cpctl/sites.db"
else
    DB_FILE="/var/lib/lsctl/sites.db"
fi
if [ ! -f "$DB_FILE" ]; then
    exit 0
fi

LOG_DIR="/var/log/lsctl"
if [ ! -d "$LOG_DIR" ] && [ -d "/var/log/cpctl" ]; then
    LOG_DIR="/var/log/cpctl"
fi
mkdir -p "$LOG_DIR" 2>/dev/null || LOG_DIR="/tmp"
LOG_FILE="${LOG_DIR}/cron.log"

# Atomic Flocking Mutex (guarantees zero overlapping cron batches, Root-only mode 0600 in /run)
LOCK_FILE="/run/ls-cron.lock"
if [ -w "$LOCK_FILE" ] || { [ ! -e "$LOCK_FILE" ] && [ -w "/run" ]; }; then
    touch "$LOCK_FILE" 2>/dev/null || true
    chmod 600 "$LOCK_FILE" 2>/dev/null || true
    exec 201>"$LOCK_FILE"
    if ! flock -n 201; then
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] Another LeanStack cron queue process is currently running. Skipping." >> "$LOG_FILE" 2>/dev/null || true
        exit 0
    fi
fi

run_site_cron() {
    local domain="$1"
    local user="$2"
    local site_path="$3"
    local php_ver="$4"

    # Dynamically resolve PHP CLI binary
    local php_bin=""
    if [ -n "$php_ver" ] && [ -x "/usr/bin/php${php_ver}" ]; then
        php_bin="/usr/bin/php${php_ver}"
    elif command -v php &>/dev/null; then
        php_bin="$(command -v php)"
    fi

    # Dynamically resolve WP-CLI binary
    local wp_bin=""
    if [ -x "/usr/local/bin/wp" ]; then
        wp_bin="/usr/local/bin/wp"
    elif [ -x "/usr/bin/wp" ]; then
        wp_bin="/usr/bin/wp"
    elif command -v wp &>/dev/null; then
        wp_bin="$(command -v wp)"
    fi

    if [ -d "$site_path" ] && [ -n "$php_bin" ] && [ -n "$wp_bin" ]; then
        # Open basedir must permit WP-CLI execution, temporary directories, socket paths, SSL certs, and tenant roots
        local allowed_paths="/home/${user}/"
        if [[ "$site_path" != "/home/${user}"* ]]; then
            allowed_paths="${allowed_paths}:${site_path}/"
        fi
        allowed_paths="${allowed_paths}:/var/cache/angie/sites/${domain}/:/run/valkey/valkey.sock:/run/mysqld/mysqld.sock:/usr/local/bin/:/usr/bin/:/usr/share/php/:/etc/ssl/certs/:/usr/share/ca-certificates/:/etc/pki/:/etc/resolv.conf"

        # The FPM pool disables proc_open and popen. The cron sandbox strictly mirrors this disable list.
        local disabled_funcs="exec,passthru,shell_exec,system,proc_open,popen,dl,show_source,opcache_reset,opcache_flush,apcu_clear_cache,apc_clear_cache"

        local status_dir="/home/${user}/nginx"
        local alt_status_dir="${site_path}/wp-content/nginx-custom"
        local cron_meta_file="${status_dir}/.cron_status.json"
        local alt_cron_meta_file="${alt_status_dir}/.cron_status.json"

        write_cron_status() {
            local state="$1"
            local payload="{\"last_run\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\", \"status\": \"$state\"}"
            if [ -d "$status_dir" ]; then
                echo "$payload" > "$cron_meta_file" 2>/dev/null || true
                chown "${user}:www-data" "$cron_meta_file" 2>/dev/null || true
                chmod 664 "$cron_meta_file" 2>/dev/null || true
            fi
            if [ -d "$alt_status_dir" ]; then
                echo "$payload" > "$alt_cron_meta_file" 2>/dev/null || true
                chown "${user}:www-data" "$alt_cron_meta_file" 2>/dev/null || true
                chmod 664 "$alt_cron_meta_file" 2>/dev/null || true
            fi
        }

        update_cron_telemetry() {
            local dur="$1"
            local cpu="$2"
            local mem="$3"
            local cnt="$4"
            local iso="$5"

            local py_script="
import json, os, sys
meta_file, dur, cpu, mem, cnt, iso = sys.argv[1], float(sys.argv[2]), float(sys.argv[3]), float(sys.argv[4]), int(sys.argv[5]), sys.argv[6]
data = {}
if os.path.exists(meta_file):
    try:
        with open(meta_file, 'r') as f:
            data = json.load(f)
    except Exception:
        data = {}

hist = data.get('history', [])
if not isinstance(hist, list):
    hist = []
hist.insert(0, {
    'timestamp': iso,
    'duration_ms': dur,
    'cpu_ms': cpu,
    'memory_mb': mem,
    'events_processed': cnt,
    'ran_via': 'ls-cron-queue'
})
hist = hist[:20]

avg_dur = round(sum(h.get('duration_ms', 0) for h in hist) / len(hist), 2)
avg_cpu = round(sum(h.get('cpu_ms', 0) for h in hist) / len(hist), 2)
avg_mem = round(sum(h.get('memory_mb', 0) for h in hist) / len(hist), 2)
total_runs = int(data.get('total_runs', 0)) + 1
total_events = int(data.get('total_events_processed', 0)) + cnt

data.update({
    'last_run': iso,
    'status': 'completed',
    'ran_via': 'ls-cron-queue',
    'duration_ms': dur,
    'cpu_ms': cpu,
    'memory_mb': mem,
    'events_processed': cnt,
    'history': hist,
    'avg_duration_ms': avg_dur,
    'avg_cpu_ms': avg_cpu,
    'avg_memory_mb': avg_mem,
    'total_runs': total_runs,
    'total_events_processed': total_events
})

os.makedirs(os.path.dirname(meta_file), exist_ok=True)
with open(meta_file, 'w') as f:
    json.dump(data, f, indent=2)
"
            if [ -d "$status_dir" ]; then
                python3 -c "$py_script" "$cron_meta_file" "$dur" "$cpu" "$mem" "$cnt" "$iso" 2>/dev/null || true
                chown "${user}:www-data" "$cron_meta_file" 2>/dev/null || true
                chmod 664 "$cron_meta_file" 2>/dev/null || true
            fi
            if [ -d "$alt_status_dir" ]; then
                python3 -c "$py_script" "$alt_cron_meta_file" "$dur" "$cpu" "$mem" "$cnt" "$iso" 2>/dev/null || true
                chown "${user}:www-data" "$alt_cron_meta_file" 2>/dev/null || true
                chmod 664 "$alt_cron_meta_file" 2>/dev/null || true
            fi
        }

        write_cron_status "running"

        # Ensure tenant temporary directory exists
        if [ -n "$user" ] && [ -d "/home/${user}" ]; then
            [ -d "/home/${user}/tmp" ] || mkdir -p "/home/${user}/tmp" 2>/dev/null || true
            chmod 700 "/home/${user}/tmp" 2>/dev/null || true
            chown "${user}:${user}" "/home/${user}/tmp" 2>/dev/null || true
        fi

        # Run WP-CLI cron event runner as tenant user within site root with strict PHP sandboxing
        local cron_out=""
        cron_out=$(
            cd "$site_path" 2>/dev/null || true
            local sudo_cmd=()
            if [ "$(id -u)" -eq 0 ]; then
                sudo_cmd=(sudo -u "$user" -H)
            fi
            local err_tmp
            err_tmp=$(mktemp)

            local t0 t1 tel_dur
            t0=$(date +%s%3N 2>/dev/null || python3 -c 'import time; print(int(time.time()*1000))')

            out=$(timeout 60 env TMPDIR="/home/${user}/tmp" WP_CLI_DISABLE_AUTO_CHECK_UPDATE=1 COLUMNS=80 TERM=dumb \
                "${sudo_cmd[@]}" "$php_bin" \
                -d sys_temp_dir="/home/${user}/tmp" \
                -d upload_tmp_dir="/home/${user}/tmp" \
                -d session.save_path="/home/${user}/tmp" \
                -d open_basedir="${allowed_paths}" \
                -d disable_functions="${disabled_funcs}" \
                -d display_errors=Off \
                -d error_reporting="E_ALL & ~E_WARNING & ~E_NOTICE & ~E_DEPRECATED" \
                "$wp_bin" cron event run --due-now --path="$site_path" 2> "$err_tmp" || true)

            t1=$(date +%s%3N 2>/dev/null || python3 -c 'import time; print(int(time.time()*1000))')
            tel_dur=$((t1 - t0))
            [ "$tel_dur" -lt 0 ] && tel_dur=0

            # Log all errors and warnings directly without suppression so operators see sandbox violations
            if [ -s "$err_tmp" ]; then
                cat "$err_tmp" >> "$LOG_FILE"
            fi
            rm -f "$err_tmp"

            local tel_count=0
            if [[ "$out" =~ Executed\ a\ total\ of\ ([0-9]+)\ cron\ events ]]; then
                tel_count="${BASH_REMATCH[1]}"
            elif [[ "$out" =~ Executed\ the\ cron\ event ]]; then
                tel_count=$(grep -c "Executed the cron event" <<< "$out" || echo 0)
            fi

            echo "LS_CRON_EXEC:${tel_dur}:${tel_count}"
        )

        local tel_dur=0
        local tel_count=0
        if [[ "$cron_out" =~ LS_CRON_EXEC:([0-9.]+):([0-9]+) ]]; then
            tel_dur="${BASH_REMATCH[1]}"
            tel_count="${BASH_REMATCH[2]}"
        fi
        local iso_now
        iso_now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        update_cron_telemetry "$tel_dur" "0" "0" "$tel_count" "$iso_now"
    fi
}
export -f run_site_cron
export LOG_FILE

TARGET_DOMAIN=""
for arg in "$@"; do
    case "$arg" in
        --domain=*)
            TARGET_DOMAIN="${arg#*=}"
            ;;
        --all)
            TARGET_DOMAIN=""
            ;;
    esac
done

# Query active sites: domain, user, site_path, php_version (LS-20: parameterized argv)
if [ -f "${LIB_DIR}/db.py" ]; then
    SITES=$(python3 "${LIB_DIR}/db.py" cron-sites "$DB_FILE" "$TARGET_DOMAIN")
else
    SITES=$(python3 -c "
import sqlite3, sys
try:
    conn = sqlite3.connect(sys.argv[1])
    cur = conn.cursor()
    if len(sys.argv) > 2 and sys.argv[2]:
        cur.execute('SELECT domain, user, site_path, php_version FROM sites WHERE domain = ?', (sys.argv[2],))
    else:
        cur.execute('SELECT domain, user, site_path, php_version FROM sites')
    for row in cur.fetchall():
        print(f'{row[0]}|{row[1]}|{row[2]}|{row[3]}')
    conn.close()
except Exception:
    pass
" "$DB_FILE" "$TARGET_DOMAIN")
fi

if [ -z "$SITES" ]; then
    exit 0
fi

# Execute with max 4 parallel workers (Zero CPU starvation)
echo "$SITES" | while IFS='|' read -r domain user site_path php_ver; do
    if [ -n "$domain" ]; then
        echo "$domain $user $site_path $php_ver"
    fi
done | xargs -r -n 4 -P 4 bash -c 'run_site_cron "$@"' _ || true

exit 0
