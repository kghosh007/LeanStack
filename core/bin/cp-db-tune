#!/usr/bin/env bash
# ==============================================================================
# LeanStack DB Tune Legacy Compatibility Wrapper (cp-db-tune -> ls-db-tune)
# ==============================================================================
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET="${SCRIPT_DIR}/ls-db-tune"
if [ ! -f "$TARGET" ] && [ -f "/usr/local/bin/ls-db-tune" ]; then
    TARGET="/usr/local/bin/ls-db-tune"
fi

TARGET_REAL="$(readlink -f "$TARGET" 2>/dev/null || echo "$TARGET")"
CUR_REAL="$(readlink -f "$0" 2>/dev/null || echo "$0")"

if [ -n "${_LEANSTACK_CPDBTUNE_LOOP:-}" ] || [ "$TARGET_REAL" == "$CUR_REAL" ]; then
    echo "❌ Error: Circular delegation detected. cp-db-tune and ls-db-tune resolve to the same binary ($CUR_REAL)." >&2
    exit 1
fi

export _LEANSTACK_CPDBTUNE_LOOP=1
exec python3 "$TARGET" "$@"
