import sqlite3
conn = sqlite3.connect('$DB_FILE')
cur = conn.cursor()
cur.execute('SELECT id, domain, user, php_version, pool_mode, memory_limit, profile_used, created_at FROM sites')
rows = cur.fetchall()
print(f'{\"ID\":<4} {\"DOMAIN\":<26} {\"TENANT USER\":<16} {\"PHP\":<6} {\"POOL\":<8} {\"MEM\":<6} {\"PROFILE\":<18} {\"CREATED AT\"}')
print('-' * 100)
for r in rows:
    print(f'{r[0]:<4} {r[1]:<26} {r[2]:<16} {r[3]:<6} {r[4]:<8} {r[5]:<6} {r[6]:<18} {r[7]}')
