#!/usr/bin/env python3
"""
LeanStack Nginx Configuration & Security Headers Linter (cp-nginx-linter)
Enforces multi-tenant sandbox constraints, AST/token isolation, and WebAssembly CSP rules.
"""

import sys
import os
import re
import json
import argparse
import ipaddress
import socket

PROHIBITED_DIRECTIVES = {
    "user", "include", "ssi", "alias", "listen", "server_name", "ssl_certificate",
    "ssl_certificate_key", "ssl_trusted_certificate", "ssl_dhparam",
    "access_by_lua", "content_by_lua", "rewrite_by_lua", "init_by_lua",
    "init_worker_by_lua", "header_filter_by_lua", "body_filter_by_lua",
    "log_by_lua", "lua_package_path", "lua_package_cpath",
    "client_body_temp_path", "proxy_temp_path", "fastcgi_temp_path",
    "uwsgi_temp_path", "scgi_temp_path", "perl", "perl_modules",
    "perl_require", "load_module", "daemon", "master_process",
    "worker_processes", "worker_cpu_affinity", "worker_rlimit_nofile",
    "events", "http", "stream", "mail",
    "uwsgi_pass", "scgi_pass", "grpc_pass", "memcached_pass", "resolver"
}

def _forbidden_ip(value):
    try:
        addr = ipaddress.ip_address(value)
    except ValueError:
        return False
    return (
        addr.is_private or addr.is_loopback or addr.is_link_local
        or addr.is_reserved or addr.is_multicast or addr.is_unspecified
    )


def _mapped_addresses(host):
    mapped = os.environ.get("LEANSTACK_RESOLVE", "")
    for item in mapped.split(","):
        if "=" not in item:
            continue
        name, addr = item.split("=", 1)
        if name.strip() == host:
            addr = addr.strip()
            return [addr] if addr else []
    return None


def _resolve_host(host):
    forced = _mapped_addresses(host)
    if forced is not None:
        return forced
    try:
        infos = socket.getaddrinfo(host, None, type=socket.SOCK_STREAM)
    except socket.gaierror:
        return []
    return sorted({item[4][0] for item in infos})


def _proxy_host(target):
    """Host of a proxy URL, after userinfo, brackets, and a single port."""
    raw = target.strip().strip("\"'").split()[0]
    if raw.startswith("unix:"):
        return ""
    if "://" in raw:
        raw = raw.split("://", 1)[1]
    raw = raw.split("/", 1)[0].split("?", 1)[0]
    if "@" in raw:
        raw = raw.rsplit("@", 1)[1]
    if raw.startswith("["):
        end = raw.find("]")
        return raw[1:end] if end > 1 else ""
    if raw.count(":") == 1:
        raw = raw.split(":", 1)[0]
    return raw


def _reject_upstream(idx, directive, target, allow_unix=False, tenant_user=None):
    """Reject variable targets, non-unix fastcgi, and any proxy host that is not a pinned public literal."""
    if "$" in target:
        return {
            "valid": False,
            "error": f"Line {idx}: variable proxy target",
            "line": idx,
        }
    raw = target.strip().strip("\"'").split()[0]
    if raw.startswith("unix:"):
        if allow_unix:
            socket_path = raw[5:]
            if not socket_path.startswith(("/run/php/", "/var/run/php/")):
                return {
                    "valid": False,
                    "error": f"Line {idx}: fastcgi_pass Unix socket must reside in /run/php/.",
                    "line": idx,
                }
            if not socket_path.endswith(".sock"):
                return {
                    "valid": False,
                    "error": f"Line {idx}: fastcgi_pass Unix socket must end in .sock.",
                    "line": idx,
                }
            if tenant_user and not (socket_path.endswith(f"-{tenant_user}.sock") or socket_path.endswith(f"/{tenant_user}.sock")):
                return {
                    "valid": False,
                    "error": f"Line {idx}: fastcgi_pass can only reference Unix socket for tenant '{tenant_user}'.",
                    "line": idx,
                }
            return None
        return {
            "valid": False,
            "error": f"Line {idx}: {directive} host is not a public address.",
            "line": idx,
        }

    if directive == "fastcgi_pass" and not raw.startswith("unix:"):
        return {
            "valid": False,
            "error": f"Line {idx}: fastcgi_pass host is not a public address.",
            "line": idx,
        }

    host = _proxy_host(target)
    if not host:
        return {
            "valid": False,
            "error": f"Line {idx}: {directive} host is not a public address.",
            "line": idx,
        }
    if _forbidden_ip(host):
        return {
            "valid": False,
            "error": f"Line {idx}: {directive} cannot target internal or metadata host '{host}'.",
            "line": idx,
        }

    forced = _mapped_addresses(host)
    if forced is not None:
        if not forced or any(_forbidden_ip(addr) for addr in forced):
            return {
                "valid": False,
                "error": f"Line {idx}: {directive} host '{host}' does not resolve to a public address.",
                "line": idx,
            }
        addresses = forced
    else:
        try:
            ipaddress.ip_address(host)
            addresses = [host]
        except ValueError:
            return {
                "valid": False,
                "error": f"Line {idx}: {directive} host '{host}' does not resolve to a pinned public address. Hostnames requiring runtime DNS resolution are prohibited; use a literal public IP address.",
                "line": idx,
            }

    if not addresses or any(_forbidden_ip(addr) for addr in addresses):
        return {
            "valid": False,
            "error": f"Line {idx}: {directive} host '{host}' does not resolve to a public address.",
            "line": idx,
        }
    return None

def lint_headers(filepath, strict_csp=False):
    """Lints security-headers.conf to ensure only safe add_header directives exist."""
    if not os.path.exists(filepath):
        return {"valid": False, "error": f"File not found: {filepath}", "line": 0}

    with open(filepath, "r", encoding="utf-8", errors="replace") as f:
        lines = f.readlines()

    csp_found = False
    csp_has_worker_blob = False

    for idx, raw_line in enumerate(lines, 1):
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue

        if not line.endswith(";"):
            return {
                "valid": False,
                "error": f"Line {idx}: Missing terminating semicolon ';'.",
                "line": idx
            }

        tokens = line[:-1].strip().split()
        if not tokens:
            continue

        directive = tokens[0].lower()
        if directive != "add_header":
            return {
                "valid": False,
                "error": f"Line {idx}: Unauthorized directive '{directive}'. Only 'add_header' is allowed in security headers.",
                "line": idx
            }

        # Check for matching quotes
        rest = " ".join(tokens[1:])
        quote_count_single = rest.count("'")
        quote_count_double = rest.count('"')
        if quote_count_single % 2 != 0 or quote_count_double % 2 != 0:
            return {
                "valid": False,
                "error": f"Line {idx}: Unmatched quotes in add_header directive.",
                "line": idx
            }

        # Inspect Content-Security-Policy
        if len(tokens) >= 2 and tokens[1].lower().strip('"\'') == "content-security-policy":
            csp_found = True
            csp_text = line.lower()
            if "worker-src" in csp_text:
                if "blob:" in csp_text:
                    csp_has_worker_blob = True
            else:
                # If worker-src isn't explicitly set, check default-src
                if "default-src" in csp_text and "blob:" in csp_text:
                    csp_has_worker_blob = True

    if csp_found and not csp_has_worker_blob:
        msg = "Content-Security-Policy detected without 'worker-src ... blob:;'. WebAssembly client-side media requires 'worker-src \\'self\\' blob:;'."
        if strict_csp:
            return {"valid": False, "error": msg, "line": 0}

    return {"valid": True, "message": "Security headers verified successfully."}


def tokenize_nginx(text):
    """
    Tokenizes Nginx configuration text into (token_type, token_value, line_no).
    Handles single/double quoted strings with escapes, and ignores comments (#).
    """
    tokens = []
    i = 0
    n = len(text)
    line_no = 1

    while i < n:
        ch = text[i]

        if ch == '\n':
            line_no += 1
            i += 1
            continue

        if ch in ' \t\r':
            i += 1
            continue

        if ch == '#':
            while i < n and text[i] != '\n':
                i += 1
            continue

        if ch in ';{}':
            tokens.append((ch, ch, line_no))
            i += 1
            continue

        start_line = line_no
        token_chars = []
        unmatched_quote = False
        while i < n and text[i] not in ' \t\r\n;{}#':
            if text[i] in ('"', "'"):
                quote_char = text[i]
                token_chars.append(quote_char)
                i += 1
                closed = False
                while i < n:
                    qch = text[i]
                    if qch == '\n':
                        line_no += 1
                    token_chars.append(qch)
                    if qch == '\\' and i + 1 < n:
                        i += 1
                        token_chars.append(text[i])
                        if text[i] == '\n':
                            line_no += 1
                    elif qch == quote_char:
                        closed = True
                        i += 1
                        break
                    i += 1
                if not closed:
                    unmatched_quote = True
                    break
            else:
                token_chars.append(text[i])
                i += 1

        if unmatched_quote:
            return None, f"Line {start_line}: Unmatched quote in directive."
        tokens.append(('WORD', ''.join(token_chars), start_line))

    return tokens, None


def parse_statements(tokens):
    """
    Groups tokens into statement and block events.
    Yields ('STMT', name, args, line_no) or ('BLOCK_START', name, args, line_no) or ('BLOCK_END', None, [], line_no).
    """
    current_words = []
    stmt_line = None

    for t_type, t_val, t_line in tokens:
        if t_type == 'WORD':
            if not current_words:
                stmt_line = t_line
            current_words.append(t_val)
        elif t_type == ';':
            if current_words:
                yield ('STMT', current_words[0], current_words[1:], stmt_line)
                current_words = []
                stmt_line = None
        elif t_type == '{':
            if current_words:
                yield ('BLOCK_START', current_words[0], current_words[1:], stmt_line)
                current_words = []
                stmt_line = None
            else:
                yield ('BLOCK_START', '', [], t_line)
        elif t_type == '}':
            if current_words:
                yield ('STMT', current_words[0], current_words[1:], stmt_line)
                current_words = []
                stmt_line = None
            yield ('BLOCK_END', None, [], t_line)

    if current_words:
        yield ('STMT', current_words[0], current_words[1:], stmt_line)


def lint_rules(filepath, tenant_user=None):
    """Lints custom-early.conf and custom-rules.conf for multi-tenant safety."""
    if not os.path.exists(filepath):
        return {"valid": False, "error": f"File not found: {filepath}", "line": 0}

    with open(filepath, "r", encoding="utf-8", errors="replace") as f:
        content = f.read()

    tokens, err = tokenize_nginx(content)
    if err:
        return {"valid": False, "error": err, "line": 0}

    brace_depth = 0
    lines_count = content.count("\n") + 1

    for stmt_type, name, args, idx in parse_statements(tokens):
        if stmt_type == 'BLOCK_START':
            brace_depth += 1
        elif stmt_type == 'BLOCK_END':
            brace_depth -= 1
            if brace_depth < 0:
                return {"valid": False, "error": f"Line {idx}: Unexpected closing brace '}}'.", "line": idx}
            continue

        if not name:
            continue

        directive = name.lower()

        # Reject prohibited directives and unknown/unauthorized *_pass directives
        if directive in PROHIBITED_DIRECTIVES or (directive.endswith("_pass") and directive not in ("proxy_pass", "fastcgi_pass")):
            return {
                "valid": False,
                "error": f"Line {idx}: Directive '{name}' is strictly prohibited for tenant security.",
                "line": idx
            }

        # Check path traversal and boundaries in root
        if directive == "root":
            if not args:
                return {"valid": False, "error": f"Line {idx}: Directive root missing path.", "line": idx}
            target_path = os.path.normpath(args[0].strip("\"'"))
            if ".." in target_path or ".." in args[0]:
                return {
                    "valid": False,
                    "error": f"Line {idx}: Directory traversal '..' is prohibited in root.",
                    "line": idx
                }
            if tenant_user:
                expected_prefix = f"/home/{tenant_user}/htdocs"
                if target_path != expected_prefix and not target_path.startswith(expected_prefix + "/"):
                    return {
                        "valid": False,
                        "error": f"Line {idx}: Directive root path must stay within {expected_prefix}.",
                        "line": idx
                    }
            else:
                for sys_dir in ("/etc", "/var", "/proc", "/sys", "/bin", "/usr", "/root", "/tmp"):
                    if target_path == sys_dir or target_path.startswith(sys_dir + "/"):
                        return {
                            "valid": False,
                            "error": f"Line {idx}: Directive root cannot target system path '{sys_dir}'.",
                            "line": idx
                        }

        # Check fastcgi_pass socket binding
        elif directive == "fastcgi_pass":
            target = " ".join(args).strip("\"'")
            rejected = _reject_upstream(idx, "fastcgi_pass", target, allow_unix=True, tenant_user=tenant_user)
            if rejected:
                return rejected

        # Check proxy_pass host pinning
        elif directive == "proxy_pass":
            target = " ".join(args).strip("\"'")
            rejected = _reject_upstream(idx, "proxy_pass", target)
            if rejected:
                return rejected

    if brace_depth != 0:
        return {"valid": False, "error": f"Unbalanced braces detected (depth: {brace_depth}).", "line": lines_count}

    return {"valid": True, "message": "Tenant custom rules verified successfully."}


def lint_cache(filepath):
    """Lints cache-config.conf to ensure only safe set $site_cache_enabled and set $site_cache_ttl directives exist."""
    if not os.path.exists(filepath):
        return {"valid": False, "error": f"File not found: {filepath}", "line": 0}

    with open(filepath, "r", encoding="utf-8", errors="replace") as f:
        lines = f.readlines()

    for idx, raw_line in enumerate(lines, 1):
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue

        if not line.endswith(";"):
            return {"valid": False, "error": f"Line {idx}: Missing terminating semicolon ';'.", "line": idx}

        # Validate allowed variables
        m_enabled = re.match(r"^set\s+\$site_cache_enabled\s+[01];$", line)
        m_ttl = re.match(r"^set\s+\$site_cache_ttl\s+[0-9]+[smhd]?;$", line)
        if not m_enabled and not m_ttl:
            return {
                "valid": False,
                "error": f"Line {idx}: Unauthorized directive in cache-config.conf. Only 'set $site_cache_enabled 0|1;' and 'set $site_cache_ttl <duration>;' are allowed.",
                "line": idx
            }

    return {"valid": True, "message": "Cache configuration verified successfully."}


def main():
    parser = argparse.ArgumentParser(description="LeanStack Nginx Configuration & Security Headers Linter")
    parser.add_argument("file", help="Path to Nginx configuration file to validate")
    parser.add_argument("--mode", choices=["auto", "rules", "headers", "cache"], default="auto", help="Validation mode")
    parser.add_argument("--user", default=None, help="Tenant username for path/socket isolation checks")
    parser.add_argument("--strict-csp", action="store_true", help="Reject CSP without WebAssembly blob: worker-src")
    args = parser.parse_args()

    mode = args.mode
    if mode == "auto":
        base = os.path.basename(args.file)
        if base == "security-headers.conf":
            mode = "headers"
        elif base == "cache-config.conf":
            mode = "cache"
        else:
            mode = "rules"

    if mode == "headers":
        result = lint_headers(args.file, strict_csp=args.strict_csp)
    elif mode == "cache":
        result = lint_cache(args.file)
    else:
        result = lint_rules(args.file, tenant_user=args.user)

    print(json.dumps(result, indent=2))
    sys.exit(0 if result["valid"] else 1)


if __name__ == "__main__":
    main()
