    print(f"✅ Created new operational profile: {p_name}")
except Exception as e:
    print(f"ERROR: {e}", file=sys.stderr)
    sys.exit(1)
PY
        exit 0
        ;;

    profile:delete|profile:rm)
        require_root
        P_NAME="${2:-}"
        [ -z "$P_NAME" ] && { echo "Usage: sudo lsctl profile:delete <name>"; exit 1; }
