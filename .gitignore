# ==============================================================================
# LeanStack Production .gitignore
# High-density autonomous WordPress hosting stack & control plane
# Prevents accidental commits of secrets, runtime state, node_modules & caches
# ==============================================================================

# Node.js & Frontend Assets
node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Python Bytecode, Caches & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Databases, WAL Files, Telemetry & Runtime State
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
sites.db
site/data/*.sqlite
site/data/*.sqlite*
site/data/*.json
site/data/*.hash
site/api/telemetry/data/
!site/data/.htaccess
/var/lib/cpctl/
/var/backups/cpctl/
/var/lib/lsctl/
/var/backups/lsctl/

# Server Logs & Runtime Diagnostics
*.log
logs/
access.log
error.log
php-slow.log
mariadb-slow.log

# Environment Variables, Secrets & Sensitive Certificates
.env
.env.*
!.env.example
*.key
*.pem
*.crt
*.csr
*.cer
*.p12
*.pfx
tls_session_ticket.key
id_rsa*
id_ed25519*

# Temporary Files, Staged Files, Archives & Backups
*.tmp
*.temp
*.staged
*.bak
*.old
*.orig
*.swp
*.swo
*~
.#*
.~lock.*#
tmp/
temp/
trash/
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# OS & Desktop Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
*.directory

# IDE & Editor Settings
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
