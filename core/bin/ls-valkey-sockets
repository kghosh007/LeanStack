#!/usr/bin/env bash
# Site users are in group tenants, not group valkey. Valkey creates the socket
# as valkey:valkey mode 0660, so after those users leave group valkey PhpRedis
# fails with "Permission denied" before AUTH. Group tenants may open the
# socket. The Valkey ACL still limits each user to that site's key prefix.
set -u

dir="${LEANSTACK_VALKEY_RUN:-/run/valkey}"
group="${LEANSTACK_VALKEY_SOCKET_GROUP:-tenants}"
owner="${LEANSTACK_VALKEY_SOCKET_OWNER:-valkey}"

grant() {
    local path="$1"
    local mode="$2"
    [ -e "$path" ] || return 0
    if [ "$(id -u)" -eq 0 ]; then
        groupadd -f "$group" 2>/dev/null || true
    fi
    chown "${owner}:${group}" "$path" 2>/dev/null || chgrp "$group" "$path" 2>/dev/null || return 0
    chmod "$mode" "$path" 2>/dev/null || true
}

[ -d "$dir" ] || exit 0
grant "$dir" 750
grant "${dir}/valkey.sock" 660
# A host upgraded from Redis keeps the old socket path.
if [ -z "${LEANSTACK_VALKEY_RUN:-}" ] && [ -d /run/redis ]; then
    grant /run/redis 750
    grant /run/redis/redis-server.sock 660
fi
