#!/usr/bin/env bash
# ==============================================================================
# LeanStack Control Plane Engine (lsctl)
# Ultra-Lightweight WordPress Control Engine for High-Density Hosting
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Delegation to installed repo payload if running from stale /usr/local/bin copy
if [ -z "${_LEANSTACK_LSCTL_DELEGATED:-}" ] && [ -f "/opt/leanstack/core/bin/lsctl" ]; then
    OPT_REAL="$(readlink -f "/opt/leanstack/core/bin/lsctl" 2>/dev/null || echo "/opt/leanstack/core/bin/lsctl")"
    CUR_REAL="$(readlink -f "$0" 2>/dev/null || echo "$0")"
    if [ "$OPT_REAL" != "$CUR_REAL" ] && [ -x "$OPT_REAL" ]; then
        export _LEANSTACK_LSCTL_DELEGATED=1
        exec "$OPT_REAL" "$@"
    fi
fi

# Configuration & Templates Paths
if [ -n "${LEANSTACK_DB:-}" ]; then
    DB_FILE="$LEANSTACK_DB"
    DB_DIR="$(dirname "$DB_FILE")"
elif [ -d "/var/lib/lsctl" ]; then
    DB_DIR="/var/lib/lsctl"
    DB_FILE="${DB_DIR}/sites.db"
elif [ -d "/var/lib/cpctl" ]; then
    DB_DIR="/var/lib/cpctl"
    DB_FILE="${DB_DIR}/sites.db"
else
    DB_DIR="/var/lib/lsctl"
    DB_FILE="${DB_DIR}/sites.db"
fi
if [ -n "${LEANSTACK_ROOT:-}" ]; then
    DB_DIR="${LEANSTACK_ROOT}/var/lib/lsctl"
    DB_FILE="${DB_DIR}/sites.db"
fi

if [ -n "${LEANSTACK_PROFILES:-}" ]; then
    PROFILES_FILE="$LEANSTACK_PROFILES"
elif [ -f "/etc/lsctl/profiles.yaml" ]; then
    PROFILES_FILE="/etc/lsctl/profiles.yaml"
elif [ -f "/etc/cpctl/profiles.yaml" ]; then
    PROFILES_FILE="/etc/cpctl/profiles.yaml"
else
    PROFILES_FILE="${SCRIPT_DIR}/../config/profiles.yaml"
fi

if [ -n "${LEANSTACK_ROOT:-}" ]; then
    PROFILES_FILE="${SCRIPT_DIR}/../config/profiles.yaml"
    TEMPLATE_DIR="${SCRIPT_DIR}/../templates"
elif [ -d "/etc/lsctl/templates" ]; then
    TEMPLATE_DIR="/etc/lsctl/templates"
elif [ -d "/etc/cpctl/templates" ]; then
    TEMPLATE_DIR="/etc/cpctl/templates"
else
    TEMPLATE_DIR="${SCRIPT_DIR}/../templates"
fi

php_pool_root() {
    if [ -n "${LEANSTACK_ROOT:-}" ]; then
        echo "${LEANSTACK_ROOT}/etc/php"
    else
        echo "/etc/php"
    fi
}

host_budget_children() {
    local repo="${SCRIPT_DIR}/../.."
    python3 - "$repo" "${LEANSTACK_SIMULATE_RAM:-}" "${LEANSTACK_SIMULATE_CORES:-}" << 'PY'
import sys
sys.path.insert(0, sys.argv[1])
from installer.probe import HardwareProbe, TuningCalculator
ram = int(sys.argv[2]) if len(sys.argv) > 2 and sys.argv[2] else None
cores = int(sys.argv[3]) if len(sys.argv) > 3 and sys.argv[3] else None
hw = HardwareProbe(sim_ram_mb=ram, sim_cores=cores).probe_all()
print(TuningCalculator(hw).to_document()["php"]["host_budget_children"])
PY
}

site_max_children() {
    local mem="$1"
    local budget="$2"
    local mb="${mem%[MmGg]}"
    case "$mem" in
        *G|*g) mb=$((mb * 1024)) ;;
    esac
    [ -z "$mb" ] && mb=256
    [ "$mb" -lt 1 ] && mb=256
    local n=$(( budget * 128 / mb ))
    [ "$n" -lt 2 ] && n=2
    echo "$n"
}

fill_spare_servers() {
    local n="$1"
    SITE_START=$(( n / 4 ))
    [ "$SITE_START" -lt 1 ] && SITE_START=1
    [ "$SITE_START" -gt "$n" ] && SITE_START=$n
    SITE_MIN_SPARE=$(( n / 8 ))
    [ "$SITE_MIN_SPARE" -lt 1 ] && SITE_MIN_SPARE=1
    [ "$SITE_MIN_SPARE" -gt "$SITE_START" ] && SITE_MIN_SPARE=$SITE_START
    SITE_MAX_SPARE=$(( n / 2 ))
    [ "$SITE_MAX_SPARE" -lt "$SITE_START" ] && SITE_MAX_SPARE=$SITE_START
    [ "$SITE_MAX_SPARE" -gt "$n" ] && SITE_MAX_SPARE=$n
    return 0
}

sum_pool_children() {
    local root="$1"
    local exclude="$2"
    local sum=0
    local f line
    [ -d "$root" ] || { echo 0; return; }
    while IFS= read -r f; do
        [ "$f" = "$exclude" ] && continue
        line=$(awk '/^pm.max_children/ {print $3; exit}' "$f")
        [ -n "$line" ] && sum=$((sum + line))
    done < <(find "$root" -path '*/fpm/pool.d/*.conf' -type f 2>/dev/null)
    echo "$sum"
}

warn_php_budget() {
    local have="$1"
    local add="$2"
    local budget="$3"
    local remain=$((budget - have))
    if [ $((have + add)) -gt "$budget" ] || [ "$remain" -lt 2 ]; then
        echo "host PHP budget exceeded"
    fi
}

write_pool_file() {
    local dest="$1"
    local user="$2"
    local socket="$3"
    local mode="$4"
    local maxc="$5"
    local web="$6"
    local mem="$7"
    local domain="$8"
    local staged="${dest}.staged"
    mkdir -p "$(dirname "$dest")"
    cp "${TEMPLATE_DIR}/pool.conf.tpl" "$staged"
    sed -i "s|{{USER_NAME}}|${user}|g" "$staged"
    sed -i "s|{{DOMAIN}}|${domain}|g" "$staged"
    sed -i "s|{{SOCKET_PATH}}|${socket}|g" "$staged"
    sed -i "s|{{POOL_MODE}}|${mode}|g" "$staged"
    sed -i "s|{{MAX_CHILDREN}}|${maxc}|g" "$staged"
    sed -i "s|{{WEB_ROOT}}|${web}|g" "$staged"
    sed -i "s|{{MEMORY_LIMIT}}|${mem}|g" "$staged"
    local spare=""
    if [ "$mode" = "dynamic" ]; then
        fill_spare_servers "$maxc"
        spare="pm.start_servers = ${SITE_START}"$'\n'"pm.min_spare_servers = ${SITE_MIN_SPARE}"$'\n'"pm.max_spare_servers = ${SITE_MAX_SPARE}"
    fi
    python3 -c 'import pathlib,sys; p=pathlib.Path(sys.argv[1]); p.write_text(p.read_text().replace("{{PM_DYNAMIC_SETTINGS}}", sys.argv[2]))' "$staged" "$spare"
    mv "$staged" "$dest"
}

valkey_tenant_acl_line() {
    local user="$1"
    local pass="$2"
    local prefix="$3"
    echo "user ${user} on >${pass} resetkeys ~${prefix}* -@all +@read +@write +@set +@sortedset +@list +@hash +@string +@bitmap +@hyperloglog +@geo +@stream +@pubsub +@transaction +@scripting +ping +echo +auth +hello +quit +info +unlink +expire +ttl +pexpire +pttl +scan +type +exists +del +persist +touch +eval +evalsha +select -flushdb -flushall"
}

grant_valkey_socket() {
    local script="${SCRIPT_DIR}/ls-valkey-sockets"
    [ -x "$script" ] || script="/opt/leanstack/core/bin/ls-valkey-sockets"
    if [ -x "$script" ]; then
        "$script" || true
    fi
}

BACKUP_DIR="/var/backups/lsctl/trash"
WP_MASTER_TEMPLATE="/opt/templates/wordpress"

# SQLite wrapper: uses sqlite3 CLI if present, or Python standard library sqlite3
db_exec() {
    local sql="$1"
    if command -v sqlite3 &>/dev/null; then
        sqlite3 "$DB_FILE" "$sql"
    else
        python3 -c "
import sqlite3, sys
conn = sqlite3.connect('$DB_FILE')
cur = conn.cursor()
try:
    for stmt in sys.argv[1].strip().split(';'):
        if stmt.strip():
            cur.execute(stmt)
    conn.commit()
finally:
    conn.close()
" "$sql"
    fi
}

db_query() {
    local sql="$1"
    if command -v sqlite3 &>/dev/null; then
        sqlite3 -separator '|' "$DB_FILE" "$sql"
    else
        python3 -c "
import sqlite3, sys
conn = sqlite3.connect('$DB_FILE')
cur = conn.cursor()
try:
    cur.execute(sys.argv[1])
    for row in cur.fetchall():
        print('|'.join(str(x) if x is not None else '' for x in row))
finally:
    conn.close()
" "$sql"
    fi
}

init_db() {
    mkdir -p "$DB_DIR"
    chmod 700 "$DB_DIR" 2>/dev/null || true
    db_exec "
CREATE TABLE IF NOT EXISTS sites (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    domain TEXT UNIQUE NOT NULL,
    user TEXT NOT NULL,
    php_version TEXT NOT NULL,
    pool_type TEXT NOT NULL,
    pool_mode TEXT DEFAULT 'dynamic',
    memory_limit TEXT DEFAULT '256M',
    table_prefix TEXT DEFAULT 'wp_',
    is_cf INTEGER DEFAULT 0,
    profile_used TEXT DEFAULT 'default',
    site_path TEXT NOT NULL,
    db_name TEXT NOT NULL,
    db_user TEXT NOT NULL,
    db_pass TEXT NOT NULL,
    admin_user TEXT NOT NULL,
    admin_pass TEXT NOT NULL,
    admin_email TEXT NOT NULL,
    wp_version TEXT DEFAULT 'latest',
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);
CREATE TABLE IF NOT EXISTS schema_migrations (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    version INTEGER UNIQUE NOT NULL,
    name TEXT NOT NULL,
    applied_at DATETIME DEFAULT CURRENT_TIMESTAMP
);
"
}

ensure_ssl_fallback() {
    if [ ! -f /etc/angie/ssl/default.crt ] || [ ! -f /etc/angie/ssl/default.key ]; then
        mkdir -p /etc/angie/ssl
        openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
            -keyout /etc/angie/ssl/default.key \
            -out /etc/angie/ssl/default.crt \
            -subj "/CN=leanstack-fallback/O=LeanStack/C=US" 2>/dev/null || true
        chown root:angie /etc/angie/ssl/default.key 2>/dev/null || chown root:www-data /etc/angie/ssl/default.key 2>/dev/null || true
        chmod 640 /etc/angie/ssl/default.key 2>/dev/null || true
        chmod 644 /etc/angie/ssl/default.crt 2>/dev/null || true
    fi
    if [ -f /etc/angie/ssl/default.key ]; then
        chown root:angie /etc/angie/ssl/default.key 2>/dev/null || chown root:www-data /etc/angie/ssl/default.key 2>/dev/null || true
        chmod 640 /etc/angie/ssl/default.key 2>/dev/null || true
    fi
    # Reconcile Angie snippets in /etc/angie/snippets
    if [ -d "/etc/angie" ]; then
        mkdir -p /etc/angie/snippets
        if [ -d "/opt/leanstack/core/snippets" ]; then
            cp -f /opt/leanstack/core/snippets/*.conf /etc/angie/snippets/ 2>/dev/null || true
        elif [ -d "${SCRIPT_DIR}/../snippets" ]; then
            cp -f "${SCRIPT_DIR}/../snippets/"*.conf /etc/angie/snippets/ 2>/dev/null || true
        fi
    fi
    ensure_angie_modules
}

ensure_angie_modules() {
    # Scaffold Angie cache-purge module loader if shared library exists
    if [ -f /usr/lib/angie/modules/ngx_http_cache_purge_module.so ] || [ -f /etc/angie/modules/ngx_http_cache_purge_module.so ]; then
        if [ ! -f /etc/angie/modules.d/cache-purge.conf ]; then
            mkdir -p /etc/angie/modules.d
            cat << 'EOF' > /etc/angie/modules.d/cache-purge.conf
load_module modules/ngx_http_cache_purge_module.so;
EOF
            systemctl restart angie 2>/dev/null || true
        fi
        if [ -f /etc/angie/angie.conf ] && ! grep -q "modules.d" /etc/angie/angie.conf; then
            sed -i '1s|^|include /etc/angie/modules.d/*.conf;\n|' /etc/angie/angie.conf
            systemctl restart angie 2>/dev/null || true
        fi
    else
        rm -f /etc/angie/modules.d/cache-purge.conf
    fi
}

COMMAND="${1:-}"

show_help() {
    cat << 'EOF'
==============================================================================
LeanStack Engine (lsctl) - Ultra-Lightweight WordPress Control Plane
==============================================================================
Commands:
  wp:create       Provision a site using an agency profile (or site:create)
  site:php        Atomic zero-downtime PHP migration (8.1 - 8.5)
  site:pool       Change one site PHP pool mode or worker cap
  site:delete     Deep multi-tier site, database & certificate teardown
  site:list       List all registered sites (--json supported)
  site:info       Display full credentials & configuration (--json supported)
  profile:list    List all available operational profiles (--json supported)
  profile:show    Display full details of a profile (--json supported)
  profile:create  Create or scaffold a custom profile
  profile:delete  Remove a custom profile
  sys:tune        Re-probe hardware and apply dynamic tuning profiles across all layers
  db:tune         Autonomous MariaDB/MySQL performance tuner & optimizer (--apply, --json)
  db:optimize     Optimize tenant tables & autonomously apply optimal MariaDB tuning (--apply)
  cf:sync         Synchronize Cloudflare IP ranges into Angie
  cron:run        Execute anti-thundering background cron queue
  cron:status     Display background cron timer & execution status (--json supported)
  watcher:status  Check background health watcher service & timer status (--json supported)
  watcher:run     Run autonomous health recovery checks immediately
  update:auto     Trigger autonomous software & security update run
  doctor          Comprehensive system health & diagnostic check
  update          Autonomous zero-downtime upgrade & migration engine
  migrate         Run database schema migrations only
  sync-tenants    Reconcile MU-plugins and configs across all sites
  stack-upgrade   Upgrade server stack component (mariadb|angie|valkey|all) [version]
  db:restore      Selectively restore tenant databases from pre-upgrade backup
  qm              Manage Query Monitor db.php drop-in (enable|disable|status)

Options for wp:create:
  sudo lsctl wp:create --domain=example.com [options]
    --profile=agency_woocommerce (Default: default)
    --php=8.5                    (Default: 8.5)
    --pool-mode=ondemand         (ondemand, dynamic, or static)
    --admin-user=user            (Overrides profile default)
    --admin-email=me@site.com    (Overrides profile default)
    --admin-pass=secret          (Auto-generates if omitted)
    --memory-limit=512M          (Overrides profile default)
    --cf                         (Enables Cloudflare Proxy & SSL headers)
    --site-title="My Store"      (Default: Domain name)

Options for site:pool:
  sudo lsctl site:pool example.com [--mode=ondemand|dynamic|static] [--max-children=N]
==============================================================================
EOF
    exit 0
}

[ -z "$COMMAND" ] || [ "$COMMAND" == "help" ] || [ "$COMMAND" == "--help" ] && show_help

# Privilege Guard for state-modifying operations
require_root() {
    if [ "$EUID" -ne 0 ]; then
        echo "❌ Error: lsctl $COMMAND requires administrative privileges." >&2
        echo "Please execute: sudo lsctl $*" >&2
        exit 1
    fi
}

case "$COMMAND" in
    sys:tune|sys-tune|tune)
        require_root
        shift
        UPGRADE_BIN="${SCRIPT_DIR}/ls-upgrade"
        [ ! -f "$UPGRADE_BIN" ] && UPGRADE_BIN="/usr/local/bin/ls-upgrade"
        if [ -f "$UPGRADE_BIN" ]; then
            exec python3 "$UPGRADE_BIN" --reconcile-tuning "$@"
        else
            echo "ERROR: Upgrade engine (${UPGRADE_BIN}) not found." >&2
            exit 1
        fi
        ;;

    db:tune|db:optimize|db-tune|db:tuner|mysqltuner)
        CURRENT_CMD="$COMMAND"
        shift
        DB_TUNE_BIN="${SCRIPT_DIR}/ls-db-tune"
        [ ! -f "$DB_TUNE_BIN" ] && DB_TUNE_BIN="/usr/local/bin/ls-db-tune"
        if [ "$CURRENT_CMD" == "mysqltuner" ] || [ "$CURRENT_CMD" == "db:tuner" ]; then
            if [ $# -eq 0 ]; then
                set -- "--mysqltuner"
            fi
        fi
        if [ "$CURRENT_CMD" == "db:optimize" ]; then
            HAS_APPLY=0
            HAS_OPTIMIZE=0
            for arg in "$@"; do
                if [ "$arg" == "--apply" ] || [ "$arg" == "--auto-tune" ]; then
                    HAS_APPLY=1
                fi
                if [ "$arg" == "--optimize" ] || [ "$arg" == "--optimize-tables" ]; then
                    HAS_OPTIMIZE=1
                fi
            done
            EXTRA_ARGS=()
            [ $HAS_OPTIMIZE -eq 0 ] && EXTRA_ARGS+=("--optimize")
            [ $HAS_APPLY -eq 0 ] && EXTRA_ARGS+=("--apply")
            set -- "${EXTRA_ARGS[@]}" "$@"
        fi
        if [ -f "$DB_TUNE_BIN" ]; then
            exec python3 "$DB_TUNE_BIN" "$@"
        elif command -v mysqltuner &>/dev/null; then
            exec mysqltuner "$@"
        else
            echo "ERROR: Database tuner tool (${DB_TUNE_BIN}) not found." >&2
            exit 1
        fi
        ;;

    watcher:status)
        JSON_OUT=0
        for arg in "$@"; do
            [ "$arg" == "--json" ] && JSON_OUT=1
        done

        WATCHER_TIMER=$(systemctl is-active ls-watcher.timer 2>/dev/null | tr -d '\r\n' || true)
        [ -z "$WATCHER_TIMER" ] && WATCHER_TIMER="inactive"
        WATCHER_SVC=$(systemctl is-active ls-watcher.service 2>/dev/null | tr -d '\r\n' || true)
        [ -z "$WATCHER_SVC" ] && WATCHER_SVC="inactive"
        AUTOUPDATE_TIMER=$(systemctl is-active ls-autoupdate.timer 2>/dev/null | tr -d '\r\n' || true)
        [ -z "$AUTOUPDATE_TIMER" ] && AUTOUPDATE_TIMER="inactive"
        AUTOUPDATE_SVC=$(systemctl is-active ls-autoupdate.service 2>/dev/null | tr -d '\r\n' || true)
        [ -z "$AUTOUPDATE_SVC" ] && AUTOUPDATE_SVC="inactive"

        LOCK_HELD="false"
        for lf in "/run/ls-maintenance.lock" "/tmp/ls-maintenance.lock"; do
            if [ -e "$lf" ]; then
                if ! flock -s -n "$lf" true 2>/dev/null; then
                    LOCK_HELD="true"
                    break
                fi
            fi
        done

        if [ "$JSON_OUT" -eq 1 ]; then
            python3 - "$WATCHER_TIMER" "$WATCHER_SVC" "$AUTOUPDATE_TIMER" "$AUTOUPDATE_SVC" "$LOCK_HELD" << 'PY'
import sys, json, datetime
wt, ws, ut, us, lh = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5]
print(json.dumps({
    "watcher_timer": wt,
    "watcher_service": ws,
    "autoupdate_timer": ut,
    "autoupdate_service": us,
    "maintenance_locked": (lh == "true"),
    "timestamp": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
}, indent=2))
PY
            exit 0
        fi

        echo "=========================================================="
        echo "🛡️ LeanStack Autonomous Watcher & Resilience Status"
        echo "=========================================================="
        echo "  Health Watcher Timer:     ${WATCHER_TIMER} (Every 60s)"
        echo "  Health Watcher Service:   ${WATCHER_SVC}"
        echo "  Auto-Update Timer:        ${AUTOUPDATE_TIMER} (Nightly 03:30)"
        echo "  Auto-Update Service:      ${AUTOUPDATE_SVC}"
        echo "  Maintenance Lock State:   $([ "$LOCK_HELD" == "true" ] && echo "Active (Locked)" || echo "Idle (Unlocked)")"
        echo "=========================================================="
        LOG_PATH="/var/log/lsctl/watcher.log"
        [ ! -f "$LOG_PATH" ] && [ -f "/var/log/cpctl/watcher.log" ] && LOG_PATH="/var/log/cpctl/watcher.log"
        if [ -f "$LOG_PATH" ]; then
            echo "Recent Watcher Activity:"
            tail -n 5 "$LOG_PATH" | sed 's/^/  /'
            echo "=========================================================="
        fi
        exit 0
        ;;

    watcher:run)
        require_root
        shift
        if [ -x "/usr/local/bin/ls-watcher" ]; then
            exec /usr/local/bin/ls-watcher "$@"
        else
            exec "${SCRIPT_DIR}/ls-watcher" "$@"
        fi
        ;;

    update:auto)
        require_root
        shift
        if [ -x "/usr/local/bin/ls-autoupdate" ]; then
            exec /usr/local/bin/ls-autoupdate "$@"
        else
            exec "${SCRIPT_DIR}/ls-autoupdate" "$@"
        fi
        ;;

    update|upgrade)
        require_root
        shift
        if [ -f "/opt/leanstack/core/bin/ls-upgrade" ]; then
            python3 /opt/leanstack/core/bin/ls-upgrade "$@"
        elif [ -f "${SCRIPT_DIR}/ls-upgrade" ]; then
            python3 "${SCRIPT_DIR}/ls-upgrade" "$@"
        elif [ -x "/usr/local/bin/ls-upgrade" ]; then
            python3 /usr/local/bin/ls-upgrade "$@"
        elif [ -x "/usr/local/bin/cp-upgrade" ]; then
            /usr/local/bin/cp-upgrade "$@"
        else
            bash "${SCRIPT_DIR}/cp-upgrade" "$@"
        fi
        exit 0
        ;;

    migrate)
        require_root
        shift
        if [ -f "/opt/leanstack/core/bin/ls-upgrade" ]; then
            python3 /opt/leanstack/core/bin/ls-upgrade --migrate-only "$@"
        elif [ -f "${SCRIPT_DIR}/ls-upgrade" ]; then
            python3 "${SCRIPT_DIR}/ls-upgrade" --migrate-only "$@"
        elif [ -x "/usr/local/bin/ls-upgrade" ]; then
            python3 /usr/local/bin/ls-upgrade --migrate-only "$@"
        elif [ -x "/usr/local/bin/cp-upgrade" ]; then
            /usr/local/bin/cp-upgrade --migrate-only "$@"
        else
            bash "${SCRIPT_DIR}/cp-upgrade" --migrate-only "$@"
        fi
        exit 0
        ;;

    sync-tenants|site:sync-plugins)
        require_root
        shift
        if [ -f "/opt/leanstack/core/bin/ls-upgrade" ]; then
            python3 /opt/leanstack/core/bin/ls-upgrade --sync-tenants-only "$@"
        elif [ -f "${SCRIPT_DIR}/ls-upgrade" ]; then
            python3 "${SCRIPT_DIR}/ls-upgrade" --sync-tenants-only "$@"
        elif [ -x "/usr/local/bin/ls-upgrade" ]; then
            python3 /usr/local/bin/ls-upgrade --sync-tenants-only "$@"
        elif [ -x "/usr/local/bin/cp-upgrade" ]; then
            /usr/local/bin/cp-upgrade --sync-tenants-only "$@"
        else
            bash "${SCRIPT_DIR}/cp-upgrade" --sync-tenants-only "$@"
        fi
        exit 0
        ;;

    stack-upgrade|stack:upgrade)
        require_root
        shift
        if [ -f "/opt/leanstack/core/bin/ls-upgrade" ]; then
            python3 /opt/leanstack/core/bin/ls-upgrade --stack-upgrade "$@"
        elif [ -f "${SCRIPT_DIR}/ls-upgrade" ]; then
            python3 "${SCRIPT_DIR}/ls-upgrade" --stack-upgrade "$@"
        elif [ -x "/usr/local/bin/ls-upgrade" ]; then
            python3 /usr/local/bin/ls-upgrade --stack-upgrade "$@"
        elif [ -x "/usr/local/bin/cp-upgrade" ]; then
            /usr/local/bin/cp-upgrade --stack-upgrade "$@"
        else
            bash "${SCRIPT_DIR}/cp-upgrade" --stack-upgrade "$@"
        fi
        exit 0
        ;;

    db:restore|db-restore)
        require_root
        shift || true
        if [ -f "/opt/leanstack/scripts/restore_tenant_dbs.py" ]; then
            python3 /opt/leanstack/scripts/restore_tenant_dbs.py "$@"
        elif [ -f "${SCRIPT_DIR}/../../scripts/restore_tenant_dbs.py" ]; then
            python3 "${SCRIPT_DIR}/../../scripts/restore_tenant_dbs.py" "$@"
        elif [ -f "${SCRIPT_DIR}/../scripts/restore_tenant_dbs.py" ]; then
            python3 "${SCRIPT_DIR}/../scripts/restore_tenant_dbs.py" "$@"
        else
            python3 "/opt/leanstack/scripts/restore_tenant_dbs.py" "$@"
        fi
        exit 0
        ;;

    qm|site:qm)
        require_root
        shift || true
        DOMAIN="${1:-}"
        ACTION="${2:-status}"
        if [ -z "$DOMAIN" ]; then
            echo "Usage: sudo lsctl qm <domain> [enable|disable|status]"
            exit 1
        fi
        SITE_ROW=$(python3 -c "
import sqlite3, sys
try:
    conn = sqlite3.connect('$DB_FILE')
    cur = conn.cursor()
    cur.execute('SELECT user, site_path, php_version FROM sites WHERE domain = ?', ('$DOMAIN',))
    row = cur.fetchone()
    if row:
        print(f'{row[0]}|{row[1]}|{row[2]}')
    conn.close()
except Exception:
    pass
" 2>/dev/null || true)
        if [ -z "$SITE_ROW" ]; then
            echo "❌ Error: Domain '$DOMAIN' not found in LeanStack database."
            exit 1
        fi
        IFS='|' read -r U_NAME S_PATH P_VER <<< "$SITE_ROW"
        QM_PLUGIN="${S_PATH}/wp-content/plugins/query-monitor"
        QM_SOURCE="${QM_PLUGIN}/wp-content/db.php"
        QM_DROPIN="${S_PATH}/wp-content/db.php"

        case "$ACTION" in
            status)
                echo "Query Monitor Drop-in Status for ${DOMAIN}:"
                if [ ! -d "$QM_PLUGIN" ]; then
                    echo "  Plugin: Not installed (${QM_PLUGIN})"
                else
                    echo "  Plugin: Installed"
                fi
                if [ -L "$QM_DROPIN" ]; then
                    TARGET=$(readlink "$QM_DROPIN" 2>/dev/null || true)
                    if [ -e "$QM_DROPIN" ]; then
                        echo "  Drop-in: Active symlink -> ${TARGET}"
                    else
                        echo "  Drop-in: Broken symlink -> ${TARGET}"
                    fi
                elif [ -f "$QM_DROPIN" ]; then
                    echo "  Drop-in: Standalone file (${QM_DROPIN})"
                else
                    echo "  Drop-in: Not installed"
                fi
                ;;
            enable)
                if [ ! -f "$QM_SOURCE" ]; then
                    echo "❌ Error: Query Monitor drop-in source not found at ${QM_SOURCE}."
                    echo "Ensure Query Monitor plugin is installed in WordPress first."
                    exit 1
                fi
                [ -L "$QM_DROPIN" ] || [ -f "$QM_DROPIN" ] && rm -f "$QM_DROPIN"
                ln -s "plugins/query-monitor/wp-content/db.php" "$QM_DROPIN" 2>/dev/null || cp "$QM_SOURCE" "$QM_DROPIN"
                chown -h "${U_NAME}:www-data" "$QM_DROPIN" 2>/dev/null || true
                chmod 644 "$QM_DROPIN" 2>/dev/null || true
                echo "✔ Query Monitor db.php drop-in enabled successfully for ${DOMAIN}."
                ;;
            disable)
                if [ -L "$QM_DROPIN" ] || [ -f "$QM_DROPIN" ]; then
                    rm -f "$QM_DROPIN"
                    echo "✔ Query Monitor db.php drop-in removed for ${DOMAIN}."
                else
                    echo "ℹ Query Monitor db.php drop-in was not active."
                fi
                ;;
            *)
                echo "Usage: sudo lsctl qm <domain> [enable|disable|status]"
                exit 1
                ;;
        esac
        exit 0
        ;;

    cf:sync)
        require_root
        if [ -x "/usr/local/bin/cp-cf-sync" ]; then
            /usr/local/bin/cp-cf-sync
        else
            bash "${SCRIPT_DIR}/cp-cf-sync"
        fi
        exit 0
        ;;

    cron:run)
        shift 1 || true
        if [ -x "/usr/local/bin/cp-cron-queue" ]; then
            /usr/local/bin/cp-cron-queue "$@"
        elif [ -x "/usr/local/bin/ls-cron-queue" ]; then
            /usr/local/bin/ls-cron-queue "$@"
        elif [ -f "${SCRIPT_DIR}/cp-cron-queue" ]; then
            bash "${SCRIPT_DIR}/cp-cron-queue" "$@"
        else
            bash "${SCRIPT_DIR}/ls-cron-queue" "$@"
        fi
        exit 0
        ;;

    cron:status)
        JSON_OUT=0
        for arg in "$@"; do
            [ "$arg" == "--json" ] && JSON_OUT=1
        done

        CRON_TIMER="inactive"
        for t in cp-cron.timer ls-cron.timer; do
            if command -v systemctl &>/dev/null; then
                st=$(systemctl is-active "$t" 2>/dev/null | tr -d '\r\n' || true)
                if [ "$st" == "active" ]; then
                    CRON_TIMER="active"
                    break
                elif [ -n "$st" ] && [ "$CRON_TIMER" == "inactive" ]; then
                    CRON_TIMER="$st"
                fi
            fi
        done

        CRON_SVC="inactive"
        for s in cp-cron.service ls-cron.service; do
            if command -v systemctl &>/dev/null; then
                st=$(systemctl is-active "$s" 2>/dev/null | tr -d '\r\n' || true)
                if [ "$st" == "active" ]; then
                    CRON_SVC="active"
                    break
                elif [ -n "$st" ] && [ "$CRON_SVC" == "inactive" ]; then
                    CRON_SVC="$st"
                fi
            fi
        done

        LOCK_HELD="false"
        for lf in "/run/ls-cron.lock" "/tmp/ls-cron.lock"; do
            if [ -e "$lf" ]; then
                if ! flock -s -n "$lf" true 2>/dev/null; then
                    LOCK_HELD="true"
                    break
                fi
            fi
        done

        if [ "$JSON_OUT" -eq 1 ]; then
            python3 - "$CRON_TIMER" "$CRON_SVC" "$LOCK_HELD" << 'PY'
import sys, json, datetime
ct, cs, lh = sys.argv[1].strip(), sys.argv[2].strip(), sys.argv[3].strip()
print(json.dumps({
    "cron_timer": ct,
    "cron_service": cs,
    "cron_locked": (lh == "true"),
    "timestamp": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
}, indent=2))
PY
            exit 0
        fi

        echo "=========================================================="
        echo "⏱ LeanStack Centralized Cron Queue Status"
        echo "=========================================================="
        FOUND_TIMER=""
        for t in cp-cron.timer ls-cron.timer; do
            if [ -f "/etc/systemd/system/$t" ] || [ -f "/lib/systemd/system/$t" ] || [ -f "/usr/lib/systemd/system/$t" ] || \
               (command -v systemctl &>/dev/null && (systemctl cat "$t" &>/dev/null || systemctl list-unit-files "$t" &>/dev/null)); then
                FOUND_TIMER="$t"
                break
            fi
        done
        if [ -n "$FOUND_TIMER" ]; then
            systemctl status "$FOUND_TIMER" --no-pager 2>/dev/null || true
        else
            echo "Timer unit not found"
        fi

        echo ""

        FOUND_SVC=""
        for s in cp-cron.service ls-cron.service; do
            if [ -f "/etc/systemd/system/$s" ] || [ -f "/lib/systemd/system/$s" ] || [ -f "/usr/lib/systemd/system/$s" ] || \
               (command -v systemctl &>/dev/null && (systemctl cat "$s" &>/dev/null || systemctl list-unit-files "$s" &>/dev/null)); then
                FOUND_SVC="$s"
                break
            fi
        done
        if [ -n "$FOUND_SVC" ]; then
            systemctl status "$FOUND_SVC" --no-pager 2>/dev/null || true
        else
            echo "Service unit not found"
        fi

        echo ""
        LOG_DISPLAY_PATH=""
        if [ -f /var/log/lsctl/cron.log ]; then
            LOG_DISPLAY_PATH="/var/log/lsctl/cron.log"
        elif [ -f /var/log/cpctl/cron.log ]; then
            LOG_DISPLAY_PATH="/var/log/cpctl/cron.log"
        fi

        if [ -n "$LOG_DISPLAY_PATH" ]; then
            if [ -w "$LOG_DISPLAY_PATH" ] && grep -q -E "open_basedir restriction in effect|not allowed to use.*--chdir" "$LOG_DISPLAY_PATH" 2>/dev/null; then
                TMP_LOG=$(mktemp)
                grep -v -E "open_basedir restriction in effect|not allowed to use.*--chdir" "$LOG_DISPLAY_PATH" > "$TMP_LOG" 2>/dev/null || true
                tail -n 1000 "$TMP_LOG" > "$LOG_DISPLAY_PATH" 2>/dev/null || true
                rm -f "$TMP_LOG" 2>/dev/null || true
            fi
            FILTERED_LOGS=$(grep -v -E "open_basedir restriction in effect|not allowed to use.*--chdir" "$LOG_DISPLAY_PATH" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -n 10 || true)
            echo "Recent Cron Logs (${LOG_DISPLAY_PATH}):"
            if [ -n "$FILTERED_LOGS" ]; then
                echo "$FILTERED_LOGS"
            else
                echo "  (No errors or execution warnings reported in cron.log)"
            fi
        else
            echo "Recent Cron Logs:"
            echo "  (No errors or execution warnings reported in cron.log)"
        fi
        exit 0
        ;;

    profile:list|profile:ls)
        JSON_MODE=0
        for arg in "$@"; do
            [ "$arg" == "--json" ] && JSON_MODE=1
        done

        python3 - "$PROFILES_FILE" "$JSON_MODE" << 'PY'
import json, sys, os

def load_yaml(text):
    try:
        import yaml
        return yaml.safe_load(text) or {}
    except ImportError:
        pass
    profiles = {}
    current = None
    curr_key = None
    for line in text.splitlines():
        line = line.rstrip()
        if not line or line.startswith('#'):
            continue
        if not line.startswith(' '):
            if ':' in line:
                current = line.split(':')[0].strip()
                profiles[current] = {}
        elif current is not None:
            s = line.strip()
            if s.startswith('- ') and curr_key:
                val = s[2:].strip().strip('"').strip("'")
                if not isinstance(profiles[current].get(curr_key), list):
                    profiles[current][curr_key] = []
                profiles[current][curr_key].append(val)
            elif ':' in s:
                k, v = s.split(':', 1)
                k = k.strip()
                v = v.strip().strip('"').strip("'")
                curr_key = k
                if v == 'true': v = True
                elif v == 'false': v = False
                elif not v: v = []
                profiles[current][k] = v
    return profiles

p_file = sys.argv[1]
json_mode = int(sys.argv[2])
try:
    if not os.path.exists(p_file):
        print(f"ERROR: Profiles configuration file {p_file} not found.", file=sys.stderr)
        sys.exit(1)
    with open(p_file, "r") as f:
        profiles = load_yaml(f.read())
    if json_mode == 1:
        print(json.dumps(profiles, indent=2))
    else:
        print("==========================================================================================")
        print("LEANSTACK OPERATIONAL WORDPRESS PROFILES")
        print("==========================================================================================")
        h_prof = "PROFILE"
        h_php = "PHP"
        h_mem = "MEM"
        h_pool = "POOL"
        h_cf = "CF"
        h_theme = "THEME"
        h_desc = "DESCRIPTION"
        print(f"{h_prof:<22} {h_php:<6} {h_mem:<7} {h_pool:<9} {h_cf:<6} {h_theme:<16} {h_desc}")
        print("-" * 95)
        for name, p in profiles.items():
            desc = p.get("description", "")
            php = p.get("php", "8.5")
            mem = p.get("memory_limit", "256M")
            pool = p.get("pool_mode", "ondemand")
            cf = "yes" if p.get("cf", False) else "no"
            theme = p.get("theme", "none") or "none"
            print(f"{name:<22} {php:<6} {mem:<7} {pool:<9} {cf:<6} {theme[:15]:<16} {desc}")
        print("==========================================================================================")
except Exception as e:
    print(f"ERROR: {e}", file=sys.stderr)
    sys.exit(1)
PY
        exit 0
        ;;

    profile:show|profile:info)
