        print(f"Cloudflare Edge: {'Enabled' if p.get('cf', False) else 'Disabled'}")
        print(f"Cache Engine:    {p.get('cache', 'on')}")
        print(f"Plugins:         {', '.join(p.get('plugins', []))}")
        print(f"Theme:           {p.get('theme', '') or 'None'}")
        print(f"Admin User:      {p.get('admin_user', 'admin')}")
        print(f"Admin Email:     {p.get('admin_email', 'admin@example.com')}")
        print(f"Timezone:        {p.get('timezone', 'UTC')}")
        print("==========================================================")
except Exception as e:
    print(f"ERROR: {e}", file=sys.stderr)
    sys.exit(1)
PY
        exit 0
        ;;

    profile:create)
        require_root
        P_NAME="${2:-}"
        [ -z "$P_NAME" ] && { echo "Usage: sudo lsctl profile:create <name> [--description=...] [--php=8.5] [--mem=256M] [--cf]"; exit 1; }

