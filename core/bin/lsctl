    site:info)
        init_db
        TARGET_DOMAIN="${2:-}"
        [ -z "$TARGET_DOMAIN" ] && { echo "Usage: lsctl site:info <domain> [--json]"; exit 1; }

        JSON_MODE=0
        for arg in "$@"; do
            [ "$arg" == "--json" ] && JSON_MODE=1
        done

        if [ "$JSON_MODE" -eq 1 ]; then
            python3 -c "
import sqlite3, json
conn = sqlite3.connect('$DB_FILE')
