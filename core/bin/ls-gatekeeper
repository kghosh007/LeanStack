#!/usr/bin/env bash
# ==============================================================================
# LeanStack Background Config Watcher & Syntax Gatekeeper (cp-gatekeeper)
# Multi-Tenant Nginx Sandboxing, Linter Inspection, and Zero-Downtime Reloads
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LINTER_BIN="${SCRIPT_DIR}/ls-nginx-linter"
[ ! -x "$LINTER_BIN" ] && LINTER_BIN="${SCRIPT_DIR}/cp-nginx-linter"
[ ! -x "$LINTER_BIN" ] && LINTER_BIN="/usr/local/bin/ls-nginx-linter"
[ ! -x "$LINTER_BIN" ] && LINTER_BIN="/usr/local/bin/cp-nginx-linter"

if [ -n "${LEANSTACK_DB:-}" ]; then
    DB_FILE="$LEANSTACK_DB"
elif [ -f "/var/lib/lsctl/sites.db" ]; then
    DB_FILE="/var/lib/lsctl/sites.db"
elif [ -f "/var/lib/cpctl/sites.db" ]; then
    DB_FILE="/var/lib/cpctl/sites.db"
else
    DB_FILE="/var/lib/lsctl/sites.db"
fi
LOG_FILE="/var/log/cpctl/gatekeeper.log"
TENANT_CUSTOM="${LEANSTACK_TENANT_CUSTOM:-/etc/angie/tenant-custom}"
mkdir -p /var/log/cpctl 2>/dev/null || true

log() {
    if [ -d "/var/log/cpctl" ] && [ -w "/var/log/cpctl" ]; then
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG_FILE" 2>/dev/null || true
    fi
}

get_domain_for_user() {
    local u="$1"
    if [[ ! "$u" =~ ^[A-Za-z0-9_-]+$ ]] || [ ! -f "$DB_FILE" ]; then
        echo ""
        return 0
    fi
    python3 - "$DB_FILE" "$u" << 'PY'
import sqlite3, sys
conn = sqlite3.connect(sys.argv[1])
try:
    row = conn.execute("SELECT domain FROM sites WHERE user=? LIMIT 1", (sys.argv[2],)).fetchone()
finally:
    conn.close()
print(row[0] if row and row[0] else "")
PY
}

process_php_hardening() {
    local filepath="$1"
    local tenant_user="$2"
    local status_file="$3"
    local active_marker="$(dirname "$filepath")/.php-hardening-active.json"

    log "PHP hardening configuration change detected for user '${tenant_user}'"
    if [ ! -f "$filepath" ]; then
        return 0
    fi

    local mode="strict"
    local revert_at=0
    if command -v python3 &>/dev/null; then
        mode=$(python3 -c "import json; d=json.load(open('$filepath')); print(d.get('mode', 'strict'))" 2>/dev/null || echo "strict")
        revert_at=$(python3 -c "import json; d=json.load(open('$filepath')); print(d.get('revert_at', 0))" 2>/dev/null || echo "0")
    fi

    local df_val="exec,passthru,shell_exec,system,proc_open,popen,curl_multi_exec,parse_ini_file,show_source,dl,opcache_reset,opcache_flush,apcu_clear_cache,apc_clear_cache"
    if [ "$mode" == "benchmark" ]; then
        df_val="exec,passthru,shell_exec,system,proc_open,popen,show_source,dl,opcache_reset,opcache_flush,apcu_clear_cache,apc_clear_cache"
        cp -f "$filepath" "$active_marker" 2>/dev/null || true
        chmod 644 "$active_marker" 2>/dev/null || true
        chown "${tenant_user}:www-data" "$active_marker" 2>/dev/null || true
    else
        rm -f "$active_marker" 2>/dev/null || true
    fi

    local pool_updated=0
    for v in 8.1 8.2 8.3 8.4 8.5; do
        local pconf="/etc/php/${v}/fpm/pool.d/${tenant_user}.conf"
        if [ -f "$pconf" ]; then
            local bak="${pconf}.bak"
            cp "$pconf" "$bak"
            if grep -q "php_admin_value\[disable_functions\]" "$pconf"; then
                sed -i "s|^php_admin_value\[disable_functions\].*|php_admin_value[disable_functions] = ${df_val}|" "$pconf"
            else
                echo "php_admin_value[disable_functions] = ${df_val}" >> "$pconf"
            fi
            pool_updated=1
        fi
    done

    if [ "$pool_updated" -eq 1 ]; then
        local php_err=""
        local test_ok=1
        for v in 8.1 8.2 8.3 8.4 8.5; do
            if command -v "php-fpm${v}" &>/dev/null; then
                if ! "php-fpm${v}" -t 2>/dev/null; then
                    test_ok=0
                    php_err="PHP-FPM ${v} syntax check failed"
                    break
                fi
            fi
        done

        if [ "$test_ok" -eq 1 ]; then
            for v in 8.1 8.2 8.3 8.4 8.5; do
                if command -v "php-fpm${v}" &>/dev/null; then
                    systemctl reload "php${v}-fpm" 2>/dev/null || true
                fi
            done
            for v in 8.1 8.2 8.3 8.4 8.5; do
                rm -f "/etc/php/${v}/fpm/pool.d/${tenant_user}.conf.bak" 2>/dev/null || true
            done
            cat > "$status_file" << EOF
{
  "status": "active",
  "file": "php-hardening.json",
  "message": "PHP hardening profile '${mode}' applied successfully.",
  "timestamp": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF
            chmod 644 "$status_file" 2>/dev/null || true
            chown "${tenant_user}:www-data" "$status_file" 2>/dev/null || true
            return 0
        else
            for v in 8.1 8.2 8.3 8.4 8.5; do
                local pconf="/etc/php/${v}/fpm/pool.d/${tenant_user}.conf"
                [ -f "${pconf}.bak" ] && mv "${pconf}.bak" "$pconf"
            done
            cat > "$status_file" << EOF
{
  "status": "error",
  "file": "php-hardening.json",
  "message": "${php_err}",
  "timestamp": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF
            chmod 644 "$status_file" 2>/dev/null || true
            chown "${tenant_user}:www-data" "$status_file" 2>/dev/null || true
            return 1
        fi
    else
        cat > "$status_file" << EOF
{
  "status": "active",
  "file": "php-hardening.json",
  "message": "PHP hardening profile '${mode}' recorded.",
  "timestamp": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF
        chmod 644 "$status_file" 2>/dev/null || true
        chown "${tenant_user}:www-data" "$status_file" 2>/dev/null || true
        return 0
    fi
}

process_tenant_config() {
    local filepath="$1"
    local filename
    filename=$(basename "$filepath")
    
    # Ignore dotfiles and backups
    if [[ "$filename" == .* ]] || [[ "$filename" == *.bak ]] || [[ "$filename" == *.staged ]]; then
        return 0
    fi

    # Target files only: custom-early.conf, custom-rules.conf, security-headers.conf, cache-config.conf, php-hardening.json
    if [[ "$filename" != "custom-early.conf" && "$filename" != "custom-rules.conf" && "$filename" != "security-headers.conf" && "$filename" != "cache-config.conf" && "$filename" != "php-hardening.json" ]]; then
        return 0
    fi

    # Extract user from path /home/<user>/nginx/<filename>
    local user_dir
    user_dir=$(dirname "$(dirname "$filepath")")
    local tenant_user
    tenant_user=$(basename "$user_dir")
    local status_file="$(dirname "$filepath")/.status.json"

    if [[ "$filename" == "php-hardening.json" ]]; then
        process_php_hardening "$filepath" "$tenant_user" "$status_file"
        return $?
    fi

    log "Tenant config change detected: ${filename} for user '${tenant_user}'"

    local domain
    domain=$(get_domain_for_user "$tenant_user")
    if [ -z "$domain" ] || [[ ! "$domain" =~ ^[A-Za-z0-9.-]+$ ]]; then
        log "No registered site for user '${tenant_user}'. Refusing to copy ${filename}."
        cat > "$status_file" << EOF
{
  "status": "error",
  "file": "${filename}",
  "message": "No site is registered for this user.",
  "timestamp": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF
        chmod 644 "$status_file" 2>/dev/null || true
        chown "${tenant_user}:www-data" "$status_file" 2>/dev/null || true
        return 1
    fi

    local prod_dir="${TENANT_CUSTOM}/${domain}"
    mkdir -p "$prod_dir" 2>/dev/null || true
    local prod_file="${prod_dir}/${filename}"

    if [ ! -f "$filepath" ]; then
        if [ -f "$prod_file" ]; then
            rm -f "$prod_file"
            validate_and_reload_angie
        fi
        cat > "$status_file" << EOF
{
  "status": "removed",
  "file": "${filename}",
  "message": "Configuration removed.",
  "timestamp": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF
        chmod 644 "$status_file" 2>/dev/null || true
        chown "${tenant_user}:www-data" "$status_file" 2>/dev/null || true
        return 0
    fi

    # 1. Run Security Linter
    if [ -x "$LINTER_BIN" ]; then
        local lint_out
        local lint_code=0
        lint_out=$("$LINTER_BIN" "$filepath" --user="$tenant_user" 2>&1) || lint_code=$?
        if [ $lint_code -ne 0 ]; then
            local err_msg
            err_msg=$(echo "$lint_out" | grep -o '"error": "[^"]*"' | cut -d'"' -f4 || echo "Security validation failed")
            [ -z "$err_msg" ] && err_msg="Security linter rejected candidate configuration."
            log "LINTER REJECT: ${filepath} -> ${err_msg}"
            
            cat > "$status_file" << EOF
{
  "status": "error",
  "file": "${filename}",
  "message": "${err_msg}",
  "timestamp": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF
            chmod 644 "$status_file" 2>/dev/null || true
            chown "${tenant_user}:www-data" "$status_file" 2>/dev/null || true
            return 1
        fi
    fi

    # 2. Sandbox Verification with Angie
    if command -v angie &>/dev/null && [ -n "$domain" ]; then
        local bak_file="${prod_file}.bak"
        [ -f "$prod_file" ] && cp "$prod_file" "$bak_file"

        cp "$filepath" "$prod_file"

        local test_err
        if test_err=$(angie -t 2>&1); then
            [ -f "$bak_file" ] && rm -f "$bak_file"
            log "Angie syntax test PASSED for ${filename} (${domain}). Reloading Angie..."
            systemctl reload angie 2>/dev/null || true

            cat > "$status_file" << EOF
{
  "status": "active",
  "file": "${filename}",
  "message": "Configuration verified and active.",
  "timestamp": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF
            chmod 644 "$status_file" 2>/dev/null || true
            chown "${tenant_user}:www-data" "$status_file" 2>/dev/null || true
            return 0
        else
            # Rollback immediately to protect production
            if [ -f "$bak_file" ]; then
                mv "$bak_file" "$prod_file"
            else
                rm -f "$prod_file"
            fi
            
            local angie_err
            angie_err=$(echo "$test_err" | grep -E "syntax error|emerg|directive" | head -n 1 | sed 's/"/\\"/g' || echo "Syntax check failed in Angie")
            log "ANGIE REJECT: ${filename} (${domain}) -> ${angie_err}"

            cat > "$status_file" << EOF
{
  "status": "error",
  "file": "${filename}",
  "message": "${angie_err}",
  "timestamp": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF
            chmod 644 "$status_file" 2>/dev/null || true
            chown "${tenant_user}:www-data" "$status_file" 2>/dev/null || true
            return 1
        fi
    else
        # If angie binary is not available (mock/testing environment)
        if [ -n "$domain" ]; then
            cp "$filepath" "$prod_file" 2>/dev/null || true
        fi
        cat > "$status_file" << EOF
{
  "status": "active",
  "file": "${filename}",
  "message": "Configuration verified and active.",
  "timestamp": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF
        chmod 644 "$status_file" 2>/dev/null || true
        chown "${tenant_user}:www-data" "$status_file" 2>/dev/null || true
        return 0
    fi
}

validate_and_reload_angie() {
    if command -v angie &>/dev/null; then
        if angie -t 2>/dev/null; then
            log "Angie syntax test PASSED. Reloading Angie..."
            systemctl reload angie 2>/dev/null || true
        else
            log "CRITICAL ALERT: Angie syntax test FAILED! Reload aborted to prevent downtime."
        fi
    fi
}

validate_and_reload_php() {
    for ver in 8.1 8.2 8.3 8.4 8.5; do
        if command -v "php-fpm${ver}" &>/dev/null; then
            if "php-fpm${ver}" -t 2>/dev/null; then
                systemctl reload "php${ver}-fpm" 2>/dev/null || true
            else
                log "CRITICAL ALERT: PHP ${ver} pool syntax error detected! Reload aborted."
            fi
        fi
    done
}

# CLI Test Mode: Direct processing of a single file
if [ "${1:-}" == "--process" ] && [ -n "${2:-}" ]; then
    process_tenant_config "$2"
    exit $?
fi

# Concurrency Protection via Flocking Mutex Lock
LOCK_FILE="/run/ls-gatekeeper.lock"
if ! touch "$LOCK_FILE" 2>/dev/null; then
    LOCK_FILE="/tmp/ls-gatekeeper.lock"
    touch "$LOCK_FILE" 2>/dev/null || true
fi
chmod 666 "$LOCK_FILE" 2>/dev/null || true
exec 202>"$LOCK_FILE"
if ! flock -n 202; then
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Another LeanStack gatekeeper process is currently running. Skipping."
    exit 0
fi

log "Starting LeanStack Syntax Gatekeeper..."

PREV_WATCH_DIRS=""
while true; do
    # Dynamically discover watch directories on each cycle
    WATCH_DIRS=""
    [ -d "/etc/angie/http.d" ] && WATCH_DIRS="$WATCH_DIRS /etc/angie/http.d"
    for user_nginx in /home/*/nginx; do
        [ -d "$user_nginx" ] && WATCH_DIRS="$WATCH_DIRS $user_nginx"
    done

    if [ -n "$WATCH_DIRS" ] && command -v inotifywait &>/dev/null; then
        if [ "$WATCH_DIRS" != "$PREV_WATCH_DIRS" ]; then
            log "Using inotifywait event listener on: $WATCH_DIRS"
            PREV_WATCH_DIRS="$WATCH_DIRS"
        fi
        # inotifywait -t 60 times out every 60s so new tenant directories can be discovered
        inotifywait -t 60 -m -r -e close_write,moved_to,delete $WATCH_DIRS 2>/dev/null | while read -r directory events filename; do
            [ -z "$filename" ] && continue
            log "Configuration file event: $events on ${directory}${filename}"
            if [[ "$directory" =~ /home/.*/nginx/ ]]; then
                sleep 0.1  # Fast debouncing for snappy response
                process_tenant_config "${directory}${filename}"
            else
                validate_and_reload_angie
                validate_and_reload_php
            fi
        done || true
    else
        log "Running periodic syntax and tenant audit loop..."
        validate_and_reload_angie
        sleep 30
    fi
    sleep 2
done
